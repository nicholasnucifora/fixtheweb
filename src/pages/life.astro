---
import Cite from "../components/Cite.astro";
import Base from "../layouts/Base.astro";
import { COUNTRIES, MEASURED, SCREENS, SELF_REPORT, SMARTPHONES, SOURCES, WORTH_IT, type CountryId, type SourceId } from "../scripts/life/data";
import {
  AGE_MAX,
  AGE_MIN,
  PARTS,
  WORTH_DEFAULT,
  formatHours,
  isNone,
  lifeOf,
  type Inputs,
  type Part,
  type Sex,
} from "../scripts/life/model";
import { AGES, SCREENS_MAX, eraText, lifeline } from "../scripts/life";

/**
 * Your Life on Screens: put in your age, and see the rest of your life carved up by sleep, work, upkeep
 * and screens, down to the free time off screens that's left. Deliberately blunt, like a plain cigarette
 * pack. The numbers and their sources are in src/scripts/life/data.ts, the sums in life/model.ts, and
 * src/scripts/life.ts makes the page follow the inputs. The markup is filled in for the default inputs,
 * so it reads right before (or without) the script.
 */

const inputs: Inputs = { age: 25, country: "au", sex: "everyone", screens: null, worth: WORTH_DEFAULT };
const life = lifeOf(inputs);
const { average } = life.today;
const one = (years: number) => years.toFixed(1);
const percent = (share: number) => `${Math.round(share * 100)}%`;
const freeYears = (years: number) => (isNone(years) ? "none" : `${one(years)} years`);

const parts: Record<Part, { label: string; about: string }> = {
  sleep: { label: "Sleep", about: "Including naps and lying awake" },
  work: { label: "Work and study", about: "Including getting there" },
  upkeep: { label: "Upkeep", about: "Eating, chores, errands, looking after people, getting ready, with no screen" },
  screens: { label: "Screens", about: "Phones, computers and TV, outside work and school" },
  free: { label: "Free time off screens", about: "Friends, family, sport, hobbies, rest, with no screen" },
};

const sexes: { id: Sex; label: string }[] = [
  { id: "female", label: "Women" },
  { id: "male", label: "Men" },
  { id: "everyone", label: "Everyone" },
];

/** A whole life for each age compared, to scale. */
const lifelines = AGES.map((age) => lifeline(lifeOf({ ...inputs, age })));
const oldest = Math.max(...lifelines.map((line) => line.end));
const lived = [
  { id: "before", label: "Lived before smartphones" },
  { id: "since", label: "Lived with smartphones" },
  { id: "rest", label: "Still to come, off screens" },
  { id: "screens", label: "Still to come, on screens" },
];

const measured = [
  {
    figure: `${Math.round((MEASURED.freeTimeOnScreens.screens / MEASURED.freeTimeOnScreens.leisure) * 100)}%`,
    text: "of Americans' free time goes on TV, games and computers, counting only what people say they were mainly doing. The phone out at the same time isn't in it.",
    source: MEASURED.freeTimeOnScreens.source,
  },
  {
    figure: formatHours(MEASURED.ukAdults.minutes / 60),
    text: "a day UK adults spend on phones, tablets and computers outside work, tracked on their own devices. Before any TV.",
    source: MEASURED.ukAdults.source,
  },
  {
    figure: `${MEASURED.ukAdults.smartphone}%`,
    text: "of that is on a smartphone: the screen that comes to dinner, to bed and to the park.",
    source: MEASURED.ukAdults.source,
  },
  {
    figure: formatHours(MEASURED.usTeens.minutes / 60),
    text: "a day on screens for US teenagers, outside school and homework.",
    source: MEASURED.usTeens.source,
  },
  {
    figure: percent(WORTH_DEFAULT),
    text: `of that, ${WORTH_IT.minutes} minutes, goes on video calls, reading and making things. The rest is watching, gaming, social media and browsing.`,
    source: WORTH_IT.source,
  },
] satisfies { figure: string; text: string; source: SourceId }[];

const asks = [
  {
    title: "Every minute counted",
    body: "Home screens, lock screen checks and flicking between apps are screen time too. Count all of it.",
  },
  {
    title: "Every screen, one total",
    body: "Phone, laptop, tablet, TV and console added up together, whichever company made them.",
  },
  {
    title: "Months, not days",
    body: "Your average for each app over a month or a year, and what that adds up to over the rest of your life, not just today's bar chart.",
  },
  {
    title: "Rate it as you go",
    body: "A quick “was that worth it?” after a video or a scroll, so the share you actually valued is measured, not remembered. Villow already does this for YouTube.",
  },
  {
    title: "In front of you, by default",
    body: "A weekly report you'll see without going looking for it, required of every operating system, with an open API so other tools can build on it.",
  },
];
---

<Base title="Your Life on Screens · Fix the Web" page="life">
  <main class="life" data-mode="average" data-average="adult" data-stage="start">
    <header class="life-intro life-col">
      <p class="eyebrow">Your life on screens</p>
      <h1>You have less life left than you think.</h1>
      <p class="lede">
        Tell us your age. We'll take the years you've got left from official life tables, carve them up the way people
        your age really spend their days, and show you what's left once screens take their share.
      </p>
    </header>

    <!-- The inputs -->
    <section class="controls life-col" id="about-you" aria-label="About you">
      <div class="control control-age">
        <label class="control-label" for="life-age">Your age</label>
        <div class="age-row">
          <button class="step" type="button" data-life-age-down aria-label="Younger">−</button>
          <output class="age-out" for="life-age" data-life-age-out>{inputs.age}</output>
          <button class="step" type="button" data-life-age-up aria-label="Older">+</button>
        </div>
        <input id="life-age" type="range" min={AGE_MIN} max={AGE_MAX} step="1" value={inputs.age} data-life-age />
      </div>

      <div class="control">
        <p class="control-label" id="life-country-label">Country</p>
        <div class="switch" role="group" aria-labelledby="life-country-label">
          {
            (Object.entries(COUNTRIES) as [CountryId, (typeof COUNTRIES)[CountryId]][]).map(([id, { label, short }]) => (
              <button type="button" data-life-country={id} aria-pressed={String(id === inputs.country)} aria-label={label}>
                {short}
              </button>
            ))
          }
        </div>
        <p class="control-label" id="life-sex-label">Life expectancy for</p>
        <div class="switch" role="group" aria-labelledby="life-sex-label">
          {
            sexes.map(({ id, label }) => (
              <button type="button" data-life-sex={id} aria-pressed={String(id === inputs.sex)}>
                {label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="control control-screens">
        <label class="control-label" for="life-screens">Your screen time a day, outside work and school</label>
        <div class="slider-row">
          <input id="life-screens" type="range" min="0" max={SCREENS_MAX} step="0.25" value={average.hours} data-life-screens />
          <output class="slider-out" for="life-screens" data-life-screens-out>{formatHours(average.hours)}</output>
        </div>
        <p class="hint only-average only-adult">
          <strong class="hint-state">Set to the average at your age:</strong>{" "}
          <span data-life-devices>{formatHours(average.devices)}</span> on phones, tablets and computers, tracked on people's
          own devices,<Cite ids={[SCREENS.devicesSource]} /> plus <span data-life-tv>{formatHours(average.tv)}</span> of TV.<Cite
            ids={["atus"]}
          /> It follows the average as you get older. Drag it to put in yours.
        </p>
        <p class="hint only-average only-teen">
          <strong class="hint-state">Set to the average for 13 to 18 year olds:</strong>{" "}
          {formatHours(SCREENS.teens.hours)} on every kind of screen, outside school and homework.<Cite
            ids={[SCREENS.teens.source]}
          /> Drag it to put in yours.
        </p>
        <p class="hint only-own">
          <strong class="hint-state">Set to your own number,</strong> kept the same for the rest of your life. Find it in Screen
          Time (iPhone) or Digital Wellbeing (Android), then add TV and games.{" "}
          <button class="text-button" type="button" data-life-use-average>Go back to the average</button>
        </p>

        <label class="control-label control-label-worth" for="life-worth">How much of it is actually worth it?</label>
        <div class="slider-row">
          <input id="life-worth" type="range" min="0" max="100" step="1" value={Math.round(inputs.worth * 100)} data-life-worth />
          <output class="slider-out" for="life-worth" data-life-worth-out>{percent(inputs.worth)}</output>
        </div>
        <p class="hint">
          Calls with people, learning, making things. It starts at {percent(WORTH_DEFAULT)}: the share of teenagers' screen
          time that goes on video calls, reading and making things.<Cite ids={[WORTH_IT.source]} />
        </p>
        <p class="hint hint-honest">
          Hard to say honestly? It is. People's own guesses at their screen time rarely match what their devices logged,<Cite
            ids={[SELF_REPORT.source]}
          /> and nobody enjoys feeling guilty about it. That's why <a href="#built-in">the tracker we're pushing for</a> would
          measure this as you go, instead of asking you to remember.
        </p>
      </div>
    </section>

    <!-- The label: the rest of your life, carved up -->
    <div class="life-col">
      <section class="label label-life" aria-labelledby="life-left-heading">
        <div class="label-head">
          <p class="label-kicker">What's left of your life</p>
          <h2 id="life-left-heading" class="counter">
            <span data-life-counter>{one(life.left)}</span> <span class="counter-unit">years</span>
          </h2>
          <p class="narration" aria-live="polite" data-life-narration>
            This is the rest of your life: {one(life.left)} years.
          </p>
          <p class="label-sub">
            You're <span data-life-age-out>{inputs.age}</span>. On average, <span data-life-who>someone</span> your age
            in <span data-life-country-name>{COUNTRIES[inputs.country].name}</span> lives to{" "}
            <span data-life-end>{one(life.end)}</span>.<Cite ids={["abs", "cdc", "ons"]} />{" "}
            <span data-life-era>{eraText(life)}</span><Cite ids={[SMARTPHONES.source]} />
          </p>
          <p class="spill" data-life-spill hidden={isNone(life.spill)}>
            There isn't enough free time for all that screen time, so {one(life.spill)} years of it comes out of meals, chores
            and errands.
          </p>
        </div>

        <ol class="legend">
          {
            PARTS.map((part) => (
              <li class="legend-item" data-part={part}>
                <span class="swatch" data-part={part} />
                <span class="legend-text">
                  <span class="legend-label">{parts[part].label}</span>
                  <span class="legend-about">{parts[part].about}</span>
                </span>
                <span class="legend-years">
                  <span data-life-years={part}>{one(life.years[part])}</span> yrs
                  {part === "screens" && (
                    <span class="legend-worth">
                      <span class="swatch" data-part="worth" />
                      <span data-life-worth-years>{one(life.worth)}</span> worth it
                    </span>
                  )}
                </span>
              </li>
            ))
          }
        </ol>

        <canvas class="grid" data-life-grid role="img" aria-label="Your life in weeks"></canvas>

        <div class="label-foot">
          <ul class="foot-key">
            <li><span class="swatch swatch-hollow" data-lived="before"></span>Each square is a week. Lived before the first iPhone</li>
            <li><span class="swatch swatch-hollow" data-lived="since"></span>Lived since</li>
          </ul>
          <button class="chip" type="button" data-life-replay>Play it again</button>
        </div>
      </section>
    </div>

    <!-- The warning, and a day -->
    <section class="verdict life-col">
      <figure class="pack">
        <div class="pack-warning">
          <p class="pack-flag">Warning</p>
          <p class="pack-text">
            Screens will take{" "}
            <span class="pack-years"><span data-life-screen-years>{one(life.years.screens)}</span> years</span>{" "}
            of the life you have left
          </p>
        </div>
        <figcaption class="pack-note">
          Worth it, by your count: <span data-life-worth-years>{one(life.worth)}</span> years. Free time away from screens:{" "}
          <span data-life-free-years>{freeYears(life.years.free)}</span>. <a href="#built-in">Want it back?</a>
        </figcaption>
        <p class="pack-brand" aria-hidden="true">Your Feed<span>Endless</span></p>
      </figure>

      <div class="day label">
        <h2 class="day-title" data-life-day-title>An average day at {inputs.age}</h2>
        <div class="day-bar" aria-hidden="true">
          {PARTS.map((part) => <span data-part={part} data-life-bar={part} style={`flex-grow: ${life.today.hours[part]}`} />)}
        </div>
        <ul class="day-list">
          {
            PARTS.map((part) => (
              <li>
                <span class="swatch" data-part={part} />
                <span>{parts[part].label}</span>
                <strong data-life-hours={part}>{formatHours(life.today.hours[part])}</strong>
              </li>
            ))
          }
        </ul>
        <p class="overflow" data-life-overflow hidden></p>
        <p class="day-note">
          Averaged over every day of the year, for everyone your age: weekends, holidays, working or not.<Cite
            ids={["atus"]}
          />
        </p>
      </div>
    </section>

    <!-- Whole lives, for different ages -->
    <section class="life-section life-col">
      <p class="eyebrow">Every generation</p>
      <h2>Everyone met smartphones at a different age</h2>
      <p>
        Someone who's 70 lived most of their life before the first iPhone. Someone who's 15 has never lived without one. Here
        are whole lives in <span data-life-country-name>{COUNTRIES[inputs.country].name}</span>, to scale, from birth to the
        average age people get to: what's been lived so far, and what screens will take of the rest,{" "}
        <span data-life-ages-how>at the average for each age</span>.
      </p>
      <div class="ages label">
        <ul class="ages-key">
          {
            lived.map((item) => (
              <li>
                <span class="swatch" data-seg={item.id} />
                {item.label}
              </li>
            ))
          }
        </ul>
        <ol class="ages-rows">
          {
            lifelines.map((line) => (
              <li class="ages-row" data-life-age-row data-current={line.age === inputs.age ? "" : undefined}>
                <span class="ages-age">{line.age}</span>
                <span class="ages-track">
                  <span class="ages-bar" style={`width: ${(line.end / oldest) * 100}%`}>
                    {line.segments.map((segment) => (
                      <span data-seg={segment.id} style={`flex-grow: ${segment.years}`} />
                    ))}
                  </span>
                </span>
                <span class="ages-stats" data-life-age-stats>
                  {line.stats}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- What's measured on devices -->
    <section class="life-section life-col">
      <p class="eyebrow">Tracked, not guessed</p>
      <h2>A phone out still takes you out of the moment</h2>
      <p>
        Time use surveys only record what people say they were mainly doing. Scrolling at dinner, on the couch with the TV
        on or in bed doesn't show up, and that's where a lot of phone use happens. So screen time on this page is tracked on
        people's own devices, with TV on top, and it counts whenever the phone's out, not just when it's the main thing
        going on.
      </p>
      <ul class="stats">
        {
          measured.map((stat) => (
            <li class="stat">
              <strong class="stat-figure">{stat.figure}</strong>
              <span>
                {stat.text}
                <Cite ids={[stat.source]} />
              </span>
            </li>
          ))
        }
      </ul>
      <div class="aside">
        <p>
          <strong>Not all screen time is wasted.</strong> A video call with your grandparents, a course, making something: that
          time is worth it, which is what the “worth it” slider is for. But for teenagers, it's {percent(WORTH_DEFAULT)} of the
          total.
        </p>
        <a class="button" href="#about-you">Put in your real numbers</a>
      </div>
    </section>

    <!-- Why a cigarette pack -->
    <section class="life-section life-col split">
      <div>
        <p class="eyebrow">Why it looks like a cigarette pack</p>
        <h2>Ugly packaging works. Australia proved it.</h2>
        <p>
          In December 2012, Australia became the first country to sell cigarettes in plain packs: every brand in the same
          drab olive brown, with graphic health warnings covering most of it. The colour, Pantone 448 C, was chosen because
          smokers in the government's research found it the least appealing, and associated it with “death”, “dirty” and
          “tar”.<Cite ids={["gfk"]} />
        </p>
        <p>
          And it worked. The government's review found the new packs cut smoking by 0.55 percentage points in under three
          years: more than 108,000 people who quit, didn't relapse or never started.<Cite ids={["pir"]} />
        </p>
        <p>
          Screens aren't cigarettes, and plenty of screen time is worth having. But the hours they take are gone just the
          same, and nothing makes the apps show you. So on this page, screen time is Pantone 448 C.
        </p>
      </div>
      <div class="swatch-card" aria-hidden="true">
        <span class="swatch-card-name">Pantone 448 C</span>
        <span class="swatch-card-words">death · dirty · tar</span>
      </div>
    </section>

    <!-- The tracker we want -->
    <section class="life-section life-col" id="built-in">
      <p class="eyebrow">What we're pushing for</p>
      <h2>Put the years on every screen</h2>
      <p>
        Nobody can judge their screen time honestly from memory. Self-reports rarely match what devices actually log,<Cite
          ids={[SELF_REPORT.source]}
        /> and no one wants to feel guilty. The numbers need to be collected for you and put in front of you. Today they're
        split up by device and by company, and shown a day or a week at a time, which makes them easy to shrug off. Every
        phone, tablet, computer and TV should come with a tracker that does this instead:
      </p>
      <div class="built-in">
        <ul class="asks">
          {
            asks.map((ask) => (
              <li class="ask">
                <h3>{ask.title}</h3>
                <p>{ask.body}</p>
              </li>
            ))
          }
        </ul>
        <figure class="phone">
          <div class="phone-screen">
            <p class="phone-day">Sunday</p>
            <div class="notice">
              <p class="notice-app"><span class="notice-icon" aria-hidden="true"></span>Screen report · last 30 days</p>
              <p class="notice-title">
                <span data-life-day-screens>{formatHours(average.hours)}</span> a day on screens
              </p>
              <p class="notice-body">
                You rated <span data-life-worth-out>{percent(inputs.worth)}</span> of it worth it. At this rate:{" "}
                <strong><span data-life-screen-years>{one(life.years.screens)}</span> years</strong> of the{" "}
                <span data-life-left>{one(life.left)}</span> you have left.
              </p>
              <div class="notice-actions" aria-hidden="true">
                <span>Where it went</span>
                <span>Rate this week</span>
              </div>
            </div>
          </div>
          <figcaption>What it could look like, with your numbers from above.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Method and sources -->
    <section class="life-section life-col method" id="method">
      <p class="eyebrow">How we worked it out</p>
      <h2>The method, and every source</h2>
      <ol class="method-steps">
        <li>
          <strong>Years left</strong> is the average remaining life expectancy for your age in your country's latest official
          life table.<Cite ids={["abs", "cdc", "ons"]} /> “Everyone” averages women's and men's. It's how long people your age
          live on average today, not a prediction for you.
        </li>
        <li>
          <strong>Each year of it</strong> is split the way people that age spend an average day, from the US Bureau of Labor
          Statistics' American Time Use Survey, where thousands of people a year describe everything they did the day
          before. It's averaged over every day of the year and everyone that age, working or not.<Cite ids={["atus"]} /> It's
          published every year and broken down by age, so we use it for every country. It starts at 15, so 13 and 14 year
          olds get the 15 to 19 figures.
        </li>
        <li>
          <strong>Sleep</strong> is personal care less the 46 minutes a day people spend getting ready and looking after their
          health, since the survey doesn't split sleep out by age.<Cite ids={["atusDetail"]} /> <strong>Work and study</strong>{" "}
          is paid work and education, including travel. <strong>Upkeep</strong> is eating, housework, shopping, caring for
          others, getting ready, calls and admin.
        </li>
        <li>
          <strong>Screens</strong> count whenever a screen is out, not just when it's the main thing someone's doing, because
          a phone at dinner still takes you out of dinner. The slider starts at the average for your age. For adults that's
          time on phones, tablets and computers outside work, tracked on people's own devices:{" "}
          {formatHours(SCREENS.devices[0].hours)} a day at 18 to 24, {formatHours(SCREENS.devices[2].hours)} from 65, and{" "}
          {formatHours(SCREENS.devices[1].hours)} for adults overall, which we use from 25 to 64 since that's what's
          published.<Cite ids={[SCREENS.devicesSource]} /> TV at your age goes on top.<Cite ids={["atus"]} /> For 13 to 17 year
          olds it's {formatHours(SCREENS.teens.hours)} on every kind of screen outside school and homework, TV included.<Cite
            ids={[SCREENS.teens.source]}
          /> Left at the average, later years follow the average for those ages. Drag it and your number is kept for life.
        </li>
        <li>
          <strong>Free time</strong> is leisure and sport, plus volunteering and religious activities. Screen time comes out
          of that first. Whatever doesn't fit comes out of meals, chores and errands. It never comes out of sleep, work or
          school, so screens used there aren't counted at all.
        </li>
        <li>
          <strong>One thing could count twice:</strong> scrolling while the TV's on. It doesn't change the answer for most
          people: even if half of all TV time had a phone going too, screens would still take more than all the free time
          people have from 18 to 64.
        </li>
        <li>
          <strong>Worth it</strong> is your call, and only splits the screens block: it doesn't give any years back. It starts
          at {percent(WORTH_DEFAULT)}, the {WORTH_IT.minutes} minutes of teenagers' {formatHours(WORTH_IT.of / 60)} that go on
          video calls, reading and making things.<Cite ids={[WORTH_IT.source]} /> Nobody has measured the same for adults.
        </li>
        <li>
          <strong>Before and since smartphones</strong> splits the years you've lived at 29 June 2007, when the first iPhone
          went on sale.<Cite ids={[SMARTPHONES.source]} /> We don't know how much screen time you had before now, so those
          weeks aren't split up, only marked.
        </li>
        <li>
          <strong>It's an average.</strong> It doesn't know your job, your health or your kids. It's here to show the scale
          of it, not to predict your life.
        </li>
      </ol>

      <h3 class="sources-title">Sources</h3>
      <ol class="sources">
        {
          (Object.entries(SOURCES) as [SourceId, (typeof SOURCES)[SourceId]][]).map(([id, source]) => (
            <li id={`source-${id}`}>
              <a href={source.url} rel="noopener" target="_blank">
                {source.title}
              </a>
              <span class="source-meta">
                {source.publisher}, {source.year}
              </span>
              <span class="source-used">{source.used}</span>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</Base>

<script>
  import { mountLife } from "../scripts/life";
  mountLife();
</script>

<style is:global>
  .life {
    /* The label's print colours: the same in light and dark, like a pack. Screens are Pantone 448 C. */
    --life-paper: #f3f1ea;
    --life-paper-ink: #16171c;
    --life-paper-muted: #5f5e58;
    /*
     * Each part its own hue, checked for colour-blind separation in the order they sit in the grid. Screens
     * are Pantone 448 C, which reads grey and dark on purpose: that's the point of it.
     */
    --life-sleep: #2a78d6;
    --life-work: #4a3aa7;
    --life-upkeep: #eda100;
    --life-screens: #4a412a;
    --life-worth: #1baf7a;
    --life-free: #008300;
    /* Weeks already lived, as outlines: before the first iPhone, and since. */
    --life-past: #b9b4a6;
    --life-past-phones: #8a7440;
    /* Whole lives: still to come, off screens. */
    --life-rest: #c9d3e0;
    --life-label: #77756d;
    --life-now: #16171c;
    --life-warning: #111111;
    padding: calc(var(--header-height) + 3rem) 0 6rem;
  }
  .life-col {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
    box-sizing: border-box;
  }
  .life :is(button, input, a):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .life [hidden] {
    display: none !important;
  }
  .life[data-mode="average"] .only-own,
  .life[data-mode="own"] .only-average,
  .life[data-average="teen"] .only-adult,
  .life:not([data-average="teen"]) .only-teen {
    display: none;
  }
  .life .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .life p {
    margin: 0 0 1rem;
  }
  .cite {
    margin-left: 0.1em;
    font-size: 0.7em;
    font-weight: 600;
    line-height: 0;
  }
  .cite a {
    color: var(--accent);
    text-decoration: none;
  }
  .cite a:hover {
    text-decoration: underline;
  }

  /* ── Intro ── */
  .life-intro h1 {
    max-width: 16ch;
    margin: 0 0 1.25rem;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 850;
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .life .lede {
    max-width: 58ch;
    font-size: 1.25rem;
    color: var(--muted);
  }

  /* ── Inputs ── */
  .controls {
    display: grid;
    grid-template-columns: auto 1fr 1.3fr;
    gap: 1.5rem 2.5rem;
    margin-block: 2.5rem 2rem;
  }
  @media (max-width: 900px) {
    .controls {
      grid-template-columns: 1fr 1fr;
    }
    .control-screens {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .controls {
      grid-template-columns: 1fr;
    }
  }
  .control {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-width: 0;
  }
  .control-label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--muted);
  }
  .life .control-label {
    margin: 0;
  }
  .control .switch + .control-label {
    margin-top: 0.5rem;
  }
  .age-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .age-out {
    min-width: 2.2ch;
    font-size: 3.5rem;
    font-weight: 850;
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .step {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    font: 700 1.25rem/1 system-ui, sans-serif;
    cursor: pointer;
  }
  .step:hover {
    background: var(--fill);
  }
  .life input[type="range"] {
    width: 100%;
    margin: 0;
    accent-color: var(--accent);
  }
  .switch {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    justify-self: start;
    padding: 3px;
    background: var(--fill);
    border-radius: 999px;
  }
  .switch button {
    padding: 0.5rem 0.9rem;
    font: 700 0.8125rem/1 system-ui, sans-serif;
    color: var(--muted);
    background: none;
    border: none;
    border-radius: 999px;
    cursor: pointer;
  }
  .switch button:hover {
    color: var(--ink);
  }
  .switch button[aria-pressed="true"] {
    color: var(--ink);
    background: var(--surface);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
  }
  .slider-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.25rem;
  }
  .slider-out {
    flex: none;
    min-width: 5.5ch;
    font-size: 1.5rem;
    font-weight: 800;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .life[data-mode="average"] [data-life-screens-out] {
    color: var(--muted);
  }
  .life .hint {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .control-label-worth {
    margin-top: 1rem;
  }
  .life .hint-honest {
    padding-left: 0.75rem;
    border-left: 3px solid var(--line);
  }
  .hint a,
  .text-button {
    padding: 0;
    color: var(--ink);
    background: none;
    border: none;
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }
  .hint strong {
    color: var(--ink);
  }

  /* ── The label: printed matter, the same in light and dark ── */
  .label {
    color: var(--life-paper-ink);
    background: var(--life-paper);
    border-radius: 6px;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.08),
      0 18px 50px -20px rgb(0 0 0 / 0.35);
  }
  .label-life {
    padding: clamp(1rem, 3vw, 2rem);
  }
  .label .cite a {
    color: inherit;
  }
  .label-kicker {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .life .label-kicker {
    margin: 0 0 0.25rem;
  }
  .counter {
    margin: 0;
    font-size: clamp(4rem, 14vw, 8.5rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .counter-unit {
    font-size: 0.35em;
    letter-spacing: -0.02em;
  }
  .life[data-stage="done"]:not([data-none]) .counter [data-life-counter] {
    color: var(--life-free);
  }
  .life .spill {
    margin: 0.75rem 0 0;
    padding: 0.625rem 0.875rem;
    color: #fff;
    background: var(--life-screens);
    border-radius: 4px;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .narration {
    min-height: 1.5em;
    font-size: clamp(1.125rem, 2.4vw, 1.5rem);
    font-weight: 700;
    line-height: 1.25;
  }
  .life .narration {
    margin: 0.75rem 0 0.5rem;
  }
  .label-sub {
    font-size: 0.9375rem;
    color: var(--life-paper-muted);
  }
  .legend {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 820px) {
    .legend {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
  .legend-item {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: "swatch text" "swatch years";
    grid-template-rows: auto 1fr;
    align-items: start;
    gap: 0.125rem 0.5rem;
    padding-top: 0.625rem;
    border-top: 3px solid rgb(0 0 0 / 0.12);
    transition: border-color 0.2s;
  }
  @media (max-width: 820px) {
    .legend-item {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "swatch text years";
      grid-template-rows: auto;
      align-items: center;
      padding-top: 0.5rem;
      border-top-width: 1px;
    }
  }
  .life[data-stage="sleep"] .legend-item[data-part="sleep"],
  .life[data-stage="work"] .legend-item[data-part="work"],
  .life[data-stage="upkeep"] .legend-item[data-part="upkeep"],
  .life[data-stage="screens"] .legend-item[data-part="screens"],
  .life[data-stage="done"] .legend-item[data-part="free"] {
    border-color: var(--life-paper-ink);
  }
  .swatch {
    display: inline-block;
    width: 0.875rem;
    height: 0.875rem;
    flex: none;
    border-radius: 2px;
    background: var(--swatch);
  }
  .legend .swatch {
    grid-area: swatch;
    margin-top: 0.2rem;
  }
  [data-part="sleep"] {
    --swatch: var(--life-sleep);
  }
  [data-part="work"] {
    --swatch: var(--life-work);
  }
  [data-part="upkeep"] {
    --swatch: var(--life-upkeep);
  }
  [data-part="screens"] {
    --swatch: var(--life-screens);
  }
  [data-part="free"] {
    --swatch: var(--life-free);
  }
  [data-part="worth"] {
    --swatch: var(--life-worth);
  }
  .swatch-hollow {
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--life-past);
  }
  .swatch-hollow[data-lived="since"] {
    box-shadow: inset 0 0 0 1.5px var(--life-past-phones);
  }
  .legend-text {
    grid-area: text;
    display: grid;
  }
  .legend-label {
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1.25;
  }
  .legend-about {
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--life-paper-muted);
  }
  @media (max-width: 820px) {
    .legend-about {
      display: none;
    }
  }
  .legend-years {
    grid-area: years;
    align-self: end;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--life-paper-muted);
    white-space: nowrap;
  }
  .legend-years [data-life-years] {
    font-size: 1.625rem;
    font-weight: 850;
    letter-spacing: -0.02em;
    color: var(--life-paper-ink);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 820px) {
    .legend-years [data-life-years] {
      font-size: 1.125rem;
    }
  }
  .legend-worth {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: normal;
  }
  .legend-worth .swatch {
    width: 0.625rem;
    height: 0.625rem;
  }
  @media (max-width: 820px) {
    .legend-worth {
      justify-content: flex-end;
    }
  }
  .legend-item[data-part="free"] [data-life-years] {
    color: var(--life-free);
  }
  .grid {
    display: block;
    width: 100%;
    height: 480px;
  }
  .label-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--life-paper-muted);
  }
  .foot-key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .foot-key li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .chip {
    padding: 0.55rem 0.95rem;
    font: 700 0.8125rem/1 system-ui, sans-serif;
    color: var(--life-paper-ink);
    background: transparent;
    border: 1px solid rgb(0 0 0 / 0.25);
    border-radius: 999px;
    cursor: pointer;
  }
  .chip:hover {
    background: rgb(0 0 0 / 0.06);
  }

  /* ── The warning pack, and a day ── */
  .verdict {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 2rem;
    align-items: start;
    margin-top: 3rem;
  }
  @media (max-width: 760px) {
    .verdict {
      grid-template-columns: 1fr;
    }
  }
  .pack {
    display: flex;
    flex-direction: column;
    aspect-ratio: 55 / 85;
    max-width: 22rem;
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
    padding: 0.875rem;
    color: #e9e6dc;
    background: var(--life-screens);
    border-radius: 6px;
    box-shadow: 0 18px 50px -20px rgb(0 0 0 / 0.45);
  }
  .pack-warning {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: center;
    padding: 1.25rem;
    color: #fff;
    background: var(--life-warning);
  }
  .life .pack-flag {
    align-self: flex-start;
    margin: 0 0 1rem;
    padding: 0.25rem 0.5rem;
    color: var(--life-warning);
    background: #fff;
    font-size: 0.875rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .life .pack-text {
    margin: 0;
    font-size: clamp(1.5rem, 5vw, 2rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .pack-years {
    display: block;
    margin-block: 0.15em;
    font-size: 1.6em;
    line-height: 0.95;
    color: #fff;
  }
  .pack-note {
    margin: 0.875rem 0.25rem 0;
    font-size: 0.875rem;
    line-height: 1.35;
  }
  .pack-note a {
    color: #fff;
    font-weight: 700;
  }
  .life .pack-brand {
    display: grid;
    margin: auto 0 0;
    padding: 0.875rem 0.25rem 0.25rem;
    color: #a6a193;
    font: 400 1rem/1.2 "Lucida Sans", "Lucida Grande", system-ui, sans-serif;
  }
  .pack-brand span {
    font-size: 0.75rem;
  }
  .day {
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }
  .day-title {
    margin: 0 0 1rem;
    font-size: 1.375rem;
    line-height: 1.2;
  }
  .day-bar {
    display: flex;
    height: 3rem;
    overflow: hidden;
    border-radius: 3px;
  }
  .day-bar span {
    flex-basis: 0;
    min-width: 0;
    background: var(--swatch);
    transition: flex-grow 0.25s ease;
  }
  .day-bar span + span {
    box-shadow: inset 2px 0 0 var(--life-paper);
  }
  .day-list {
    display: grid;
    gap: 0.375rem;
    margin: 1rem 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }
  .day-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .day-list strong {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }
  .life .overflow {
    padding: 0.75rem 0.875rem;
    color: #fff;
    background: var(--life-screens);
    border-radius: 4px;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .life .day-note {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--life-paper-muted);
  }

  /* ── Sections ── */
  .life-section {
    margin-top: 5rem;
  }
  .life-section h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .life-section > p,
  .split > div > p {
    max-width: 62ch;
    color: var(--muted);
  }

  /*
   * Whole lives: each bar runs from birth to the average age people get to, to scale. Lived before
   * smartphones is plain, lived with them is striped, and what's to come is off screens or on them.
   */
  .ages {
    margin-top: 1.5rem;
    padding: clamp(1rem, 3vw, 1.5rem);
  }
  .ages-key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.25rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--life-paper-muted);
  }
  .ages-key li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  [data-seg="before"] {
    background: #e6e1d4;
    box-shadow: inset 0 0 0 1px var(--life-past);
  }
  [data-seg="since"] {
    background: repeating-linear-gradient(135deg, #e6e1d4 0 3px, var(--life-past-phones) 3px 5px);
  }
  [data-seg="rest"] {
    background: var(--life-rest);
  }
  [data-seg="screens"] {
    background: var(--life-screens);
  }
  .ages-rows {
    display: grid;
    gap: 1.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ages-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    grid-template-areas: "age track" ". stats";
    align-items: center;
    gap: 0.375rem 0.75rem;
  }
  .ages-age {
    grid-area: age;
    font-size: 1.375rem;
    font-weight: 850;
    font-variant-numeric: tabular-nums;
  }
  .ages-row[data-current] .ages-age::after {
    content: "you";
    display: block;
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--life-paper-muted);
  }
  .ages-track {
    grid-area: track;
  }
  .ages-bar {
    display: flex;
    gap: 2px;
    height: 1.75rem;
    transition: width 0.25s ease;
  }
  .ages-bar span {
    flex-basis: 0;
    min-width: 0;
    border-radius: 2px;
    transition: flex-grow 0.25s ease;
  }
  .ages-stats {
    grid-area: stats;
    font-size: 0.875rem;
    color: var(--life-paper-muted);
  }

  /* Measured */
  /* The first figure's the widest claim, so it gets two columns; the rest fill in after it. */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 2rem 0;
    padding: 0;
    list-style: none;
  }
  .stat:first-child {
    grid-column: span 2;
  }
  @media (max-width: 720px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 440px) {
    .stats {
      grid-template-columns: 1fr;
    }
    .stat:first-child {
      grid-column: auto;
    }
  }
  .stat {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .stat-figure {
    font-size: 2.25rem;
    font-weight: 850;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
    white-space: nowrap;
  }
  .aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--accent);
    background: var(--fill);
    border-radius: 0 12px 12px 0;
  }
  .life .aside p {
    flex: 1 1 32ch;
    margin: 0;
    color: var(--muted);
  }
  .aside strong {
    color: var(--ink);
  }
  .life .button {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.375rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Why a pack */
  .split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 760px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
  .swatch-card {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.25rem;
    aspect-ratio: 4 / 5;
    max-width: 18rem;
    width: 100%;
    margin: 0 auto;
    padding: 1.25rem;
    box-sizing: border-box;
    background: var(--life-screens);
    border-radius: 6px;
    box-shadow: 0 18px 50px -20px rgb(0 0 0 / 0.45);
  }
  @media (max-width: 760px) {
    .swatch-card {
      aspect-ratio: 5 / 2;
      max-width: none;
    }
  }
  .swatch-card-name {
    color: #fff;
    font-size: 1.5rem;
    font-weight: 850;
  }
  .swatch-card-words {
    color: #c9c3b1;
    font-size: 0.9375rem;
  }

  /* The tracker */
  .built-in {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    align-items: center;
    margin-top: 2rem;
  }
  @media (max-width: 760px) {
    .built-in {
      grid-template-columns: 1fr;
    }
  }
  .asks {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ask {
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .ask h3 {
    margin: 0 0 0.25rem;
    font-size: 1.0625rem;
  }
  .life .ask p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .phone {
    margin: 0;
  }
  .phone-screen {
    max-width: 17rem;
    aspect-ratio: 9 / 18;
    margin: 0 auto;
    padding: 3rem 0.75rem 1rem;
    box-sizing: border-box;
    border: 10px solid #111;
    border-radius: 42px;
    background: linear-gradient(160deg, #2c3446, #151923 60%);
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.55);
  }

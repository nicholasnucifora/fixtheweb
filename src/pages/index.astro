---
import Logo from "../assets/brand/fixtheweb-logo.svg";
import SpiderString from "../components/SpiderString.astro";

// Placeholder content so there's something to scroll through.
const cards = ["Placeholder one", "Placeholder two", "Placeholder three"];
const sections = [
  { title: "Section heading", cards: true },
  { title: "Another section", cards: false },
  { title: "One more section", cards: true },
  { title: "Last section", cards: false },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fix the Web</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <!-- Takes over from the big logo once you scroll: the spider sits in .brand-spider (drawn by the badge rig below). -->
    <header class="header" inert>
      <a class="brand" href="#top" aria-label="Fix the Web: back to the top">
        <span class="brand-spider"></span>
        <span class="brand-text">
          <strong class="brand-initials">FTW</strong>
          <span class="brand-name">Fix The Web</span>
        </span>
      </a>
    </header>

    <main>
      <section class="hero" id="top">
        <h1><Logo class="logo" role="img" aria-label="Fix the Web" /></h1>
        <p>Coming soon.</p>
      </section>

      {
        sections.map((section) => (
          <section class="placeholder">
            <h2>{section.title}</h2>
            <p>
              Placeholder text. Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
              incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation.
            </p>
            {section.cards ? (
              <div class="cards">
                {cards.map((card) => (
                  <div class="card">
                    <div class="card-image" />
                    <h3>{card}</h3>
                    <p>Short placeholder description for this card.</p>
                  </div>
                ))}
              </div>
            ) : (
              <div class="block" />
            )}
          </section>
        ))
      }
    </main>

    <SpiderString anchor=".logo [data-glyph='b']" />
    <SpiderString badge=".brand-spider" />
  </body>
</html>

<script>
  // Scrolling away from the big logo fades it and its spider out, and the header (with its own
  // spider) in, as the logo's halfway gone. --swap goes 0 → 1 over that.
  const hero = document.querySelector<HTMLElement>(".hero");
  const header = document.querySelector<HTMLElement>(".header");
  const heroRig = document.querySelector<HTMLElement>("[data-spider-string]:not([data-mode='badge'])");
  let swapped: boolean | null = null;
  const update = () => {
    if (!hero || !header) return;
    const swap = Math.min(1, Math.max(0, window.scrollY / (hero.offsetHeight * 0.5)));
    document.documentElement.style.setProperty("--swap", String(swap));
    // Past halfway, the big spider can't be grabbed any more, and the header can be clicked.
    if (swap > 0.5 !== swapped) {
      swapped = swap > 0.5;
      heroRig?.toggleAttribute("data-inactive", swapped);
      header.inert = !swapped;
    }
  };
  addEventListener("scroll", update, { passive: true });
  addEventListener("resize", update);
  update();
</script>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fafaf7;
    --ink: #1b1e29;
    --muted: color-mix(in srgb, var(--ink) 60%, transparent);
    --line: color-mix(in srgb, var(--ink) 12%, transparent);
    --fill: color-mix(in srgb, var(--ink) 6%, transparent);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1b1e29;
      --ink: #f2f2ee;
    }
  }
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 18px/1.5 system-ui, sans-serif;
  }
  main {
    /* Above the string and spider, which can pass behind it… */
    position: relative;
    z-index: 1;
    /* …but presses go through to the spider back there. */
    pointer-events: none;
  }
  main p,
  .placeholder {
    pointer-events: auto;
  }

  /* ── The big logo, fading out as you scroll ── */
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    padding: 2rem;
    box-sizing: border-box;
    opacity: calc(1 - var(--swap, 0));
  }
  .spider-string:not([data-mode="badge"]) {
    opacity: calc(1 - var(--swap, 0));
  }
  h1 {
    margin: 0;
  }
  .logo {
    display: block;
    width: min(80vw, 640px);
    height: auto;
  }

  /* ── The header, fading in ── */
  .header {
    position: fixed;
    inset: 0 0 auto;
    /* Above the page; the badge spider (z-index 10) is drawn above this. */
    z-index: 5;
    display: flex;
    align-items: center;
    padding: 0.625rem 1.25rem;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    opacity: var(--swap, 0);
  }
  .spider-string[data-mode="badge"] {
    opacity: var(--swap, 0);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }
  /* Just a space: the spider in it is drawn by the badge rig, sized to this width. */
  .brand-spider {
    width: 52px;
    height: 52px;
    flex: none;
  }
  .brand-text {
    display: grid;
    line-height: 1.1;
  }
  .brand-initials {
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .brand-name {
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* ── Placeholder content ── */
  .placeholder {
    max-width: 960px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    border-top: 1px solid var(--line);
  }
  .placeholder h2 {
    margin: 0 0 0.5rem;
    font-size: 1.75rem;
  }
  .placeholder > p {
    max-width: 60ch;
    margin: 0 0 2rem;
    color: var(--muted);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .card {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .card-image {
    aspect-ratio: 16 / 10;
    border-radius: 8px;
    background: var(--fill);
  }
  .card h3 {
    margin: 0.875rem 0 0.25rem;
    font-size: 1.05rem;
  }
  .card p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .block {
    height: 260px;
    border-radius: 12px;
    background: var(--fill);
  }
</style>

---
const Header = import.meta.env.DEV ? (await import("../components/Header.astro")).default : null;
const DevStyles = import.meta.env.DEV ? (await import("../components/DevStyles.astro")).default : null;
const ColorMode = import.meta.env.DEV ? (await import("../components/ColorMode.astro")).default : null;
const StoryStyles = import.meta.env.DEV ? (await import("../components/StoryStyles.astro")).default : null;
const ProjectFooter = import.meta.env.DEV ? (await import("../components/ProjectFooter.astro")).default : null;
const PreviewState = import.meta.env.DEV ? (await import("../components/PreviewState.astro")).default : null;
const PresetSwitch = import.meta.env.DEV ? (await import("../components/PresetSwitch.astro")).default : null;
// Design controls and their scripts stay out of the public build.
const DesignPanel = import.meta.env.DEV ? (await import("../components/DesignPanel.astro")).default : null;

interface Props {
  title: string;
  /** Which page this is, for the header. */
  page: "home" | "den" | "life" | "design" | "work" | "notes" | "archive" | "ideas" | "about";
}

const { title, page } = Astro.props;
const previewPreset = import.meta.env.DEV ? (await import("../lib/page-presets")).getPagePreset(Astro.url) : undefined;
---

<html lang="en" data-coming-soon={!import.meta.env.DEV || undefined} data-preview-preset={previewPreset}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {PreviewState && <PreviewState />}
    {ColorMode && <ColorMode />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {DevStyles && <DevStyles />}
    {StoryStyles && <StoryStyles />}
  </head>
  <body>
    {import.meta.env.DEV && <a class="ftw-skip" href="#main">Skip to content</a>}
    {Header && <Header page={page} />}
    {PresetSwitch && <PresetSwitch />}
    <slot />
    {ProjectFooter && ["home", "work", "notes", "archive", "ideas", "about"].includes(page) && <ProjectFooter />}
    {DesignPanel && page === "home" && <DesignPanel />}
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fafaf7;
    --ink: #1b1e29;
    --muted: color-mix(in srgb, var(--ink) 60%, transparent);
    --line: color-mix(in srgb, var(--ink) 12%, transparent);
    --fill: color-mix(in srgb, var(--ink) 6%, transparent);
    /* Links that aren't built yet. */
    --unbuilt: color-mix(in srgb, var(--ink) 32%, transparent);
    /* The logo's green; darker on light, where the logo's own would be too faint as text. */
    --accent: #2b8666;
    /* Cards, a step up from the page. */
    --surface: #ffffff;
    /* The header's own colour, a step off the page's, so it reads as a bar over it. */
    --header-bg: #ecece4;
    --header-height: 76px;
    /* The page's content column, which the header lines up with. */
    --content-width: 960px;
    --gutter: 1.5rem;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1b1e29;
      --ink: #f2f2ee;
      --accent: #6ac7a7;
      --surface: #222633;
      --header-bg: #282c3b;
    }
  }
  html {
    scroll-behavior: smooth;
  }
  html[data-coming-soon],
  html[data-coming-soon] body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 18px/1.5 var(--body-font, system-ui), sans-serif;
  }
</style>

---
import { linkAttrs, type Link } from "./links";

interface Props {
  /** The page it's on. The home page's header fades in as you scroll past the big logo, and its logo goes back to the top. */
  page: "home" | "den" | "life";
}

const { page } = Astro.props;
const home = page === "home";

/** The header's sections and the pages under each (see links.ts for ones that aren't built yet). */
const nav: (Link & { links: Link[] })[] = [
  {
    label: "Campaign",
    links: [
      { label: "Your Life on Screens", href: "/life" },
      { label: "About SKG" },
      { label: "Our Work" },
      { label: "Statistics" },
      { label: "Past Results" },
      { label: "FAQ" },
    ],
  },
  { label: "Community", links: [{ label: "How to Help" }, { label: "Discord" }, { label: "Reddit" }] },
  { label: "Press", links: [{ label: "Press Center" }, { label: "Newsletter" }, { label: "Releases" }] },
  { label: "About Us", links: [{ label: "Team" }, { label: "EU Region" }, { label: "US Region" }, { label: "Partner" }] },
];

/** Under the logo. */
const spiderLinks = [{ label: "Spider Den", href: "/den", page: "den" }];
---

<!--
  On the home page it takes over from the big logo once you scroll: the whole header fades in, its
  logo's spider sitting in .brand-spider (drawn by the badge rig in Base.astro). Other pages have no
  big logo, so there it's always in. data-spider-ignore: presses here never grab or pluck the string.
-->
<header class="header" data-spider-ignore inert={home}>
  <div class="header-inner">
    <div class="brand-col">
      <a class="brand" href={home ? "#top" : "/"} aria-label={home ? "Fix the Web: back to the top" : "Fix the Web: home"}>
        <span class="brand-spider"></span>
        <span class="brand-text">
          <strong class="brand-initials">FTW</strong>
          <span class="brand-name">Fix The Web</span>
        </span>
      </a>
      <!-- Under the logo, like a section's links: the spider's own page. -->
      <div class="nav-drop">
        <ul class="nav-menu">
          {
            spiderLinks.map((link) => (
              <li>
                <a href={link.href} aria-current={link.page === page ? "page" : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <nav class="nav" aria-label="Main">
      <ul class="nav-list">
        {
          nav.map((section) => (
            <li class="nav-item">
              <a class="nav-top" {...linkAttrs(section)}>
                {section.label}
              </a>
              <div class="nav-drop">
                <ul class="nav-menu">
                  {section.links.map((link) => (
                    <li>
                      <a {...linkAttrs(link)}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // On the home page, scrolling away from the big logo fades the header (with its own spider) in,
  // by the time the logo's halfway gone. --swap goes 0 → 1 over that. Pages without a .hero start
  // at 1 (Base.astro) and stay there.
  const hero = document.querySelector<HTMLElement>(".hero");
  const header = document.querySelector<HTMLElement>(".header");
  let showing: boolean | null = null;
  const update = () => {
    if (!hero || !header) return;
    const swap = Math.min(1, Math.max(0, window.scrollY / (hero.offsetHeight * 0.5)));
    document.documentElement.style.setProperty("--swap", String(swap));
    // As soon as any of it shows, it can be used (and hovering it brings it fully in).
    if (swap > 0 !== showing) {
      showing = swap > 0;
      header.inert = !showing;
    }
  };
  addEventListener("scroll", update, { passive: true });
  addEventListener("resize", update);
  update();
</script>

<style is:global>
  /* ── The header: the logo on the left and the sections on the right, lined up with the content ── */
  .header {
    position: fixed;
    inset: 0 0 auto;
    /* Above the page; the badge spider (z-index 10) is drawn above this. */
    z-index: 5;
    /* Background and all: fades in as you scroll away from the big logo… */
    background: var(--header-bg);
    opacity: var(--swap, 0);
    transition: opacity 0.15s ease;
  }
  /* The header's spider fades in with it. */
  .spider-string[data-mode="badge"] {
    opacity: var(--swap, 0);
    transition: opacity 0.15s ease;
  }
  /* …and while you're over it, it's all the way in, part-way through the fade or not. */
  .header:hover,
  .header:focus-within,
  :root:has(.header:hover, .header:focus-within) .spider-string[data-mode="badge"] {
    opacity: 1;
  }
  /*
   * The same column as the page's content, so the logo starts where the headings do. The sections
   * sit in the middle of it: equal space either side keeps them centred whatever the logo's width.
   */
  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 2rem;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  /* The logo, with the Spider Den link dropping down under it like a section's links. */
  .brand-col {
    justify-self: start;
  }
  .brand {
    display: flex;
    align-items: center;
    height: var(--header-height);
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }
  /* Just a space: the spider in it is drawn by the badge rig, sized to this width. */
  .brand-spider {
    width: 52px;
    height: 52px;
    flex: none;
  }
  .brand-text {
    display: grid;
    line-height: 1.1;
    white-space: nowrap;
  }
  .brand-initials {
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .brand-name {
    font-size: 0.75rem;
    color: var(--muted);
  }

  /*
   * ── Sections ──
   * Over the header (or tabbing into it), the bar grows taller and shows every section's links at
   * once, each under its heading.
   */
  .nav-list,
  .nav-menu {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Each column is as wide as its heading, so the headings are evenly spaced; the gap leaves room for
     a link longer than its heading (Press Center) to run on into it. */
  .nav-list {
    display: flex;
    gap: 2rem;
  }
  .nav-top {
    display: flex;
    align-items: center;
    height: var(--header-height);
    padding: 0 0.875rem;
    color: inherit;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  /* Rows 0fr → 1fr: the links' own height, eased open, so the bar grows to fit the longest list. Its
     width doesn't count towards the column's (contain), so the heading alone sets that. */
  .nav-drop {
    contain: inline-size;
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows 0.25s ease,
      opacity 0.2s ease,
      visibility 0.25s;
  }
  .header:hover .nav-drop,
  .header:focus-within .nav-drop {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
  }
  /* Clipped top to bottom while it opens, but free to run on sideways. */
  .nav-menu {
    overflow-x: visible;
    overflow-y: clip;
    min-height: 0;
  }
  /* Lined up with "FTW" rather than the spider. */
  .brand-col .nav-menu {
    padding-left: calc(52px + 0.75rem - 0.875rem);
  }
  .nav-menu a[aria-current="page"] {
    color: var(--ink);
  }
  .nav-menu li:last-child {
    padding-bottom: 1.25rem;
  }
  .nav-menu a {
    display: block;
    width: max-content;
    padding: 0.4rem 0.875rem;
    border-radius: 8px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .nav-menu a:hover,
  .nav-menu a:focus-visible {
    color: var(--ink);
    background: var(--fill);
  }
  /* Not built yet: greyed out, and no highlight, since it goes nowhere. */
  .nav a[aria-disabled="true"],
  .nav a[aria-disabled="true"]:hover,
  .nav a[aria-disabled="true"]:focus-visible {
    color: var(--unbuilt);
    background: none;
    cursor: default;
  }
  /* No room for the sections on a narrow screen: just the logo, until there's a menu for them. */
  @media (max-width: 760px) {
    .nav {
      display: none;
    }
  }
</style>

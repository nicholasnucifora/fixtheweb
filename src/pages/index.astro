---
import Logo from "../assets/brand/fixtheweb-logo.svg";
import SpiderString from "../components/SpiderString.astro";

/**
 * The header's sections and the pages under each. A link with no href isn't built yet: it shows
 * greyed out and goes nowhere. Give it an href once its page exists.
 */
interface Link {
  label: string;
  href?: string;
}
const nav: (Link & { links: Link[] })[] = [
  {
    label: "Campaign",
    links: [{ label: "About SKG" }, { label: "Our Work" }, { label: "Statistics" }, { label: "Past Results" }, { label: "FAQ" }],
  },
  { label: "Community", links: [{ label: "How to Help" }, { label: "Discord" }, { label: "Reddit" }] },
  { label: "Press", links: [{ label: "Press Center" }, { label: "Newsletter" }, { label: "Releases" }] },
  { label: "About Us", links: [{ label: "Team" }, { label: "EU Region" }, { label: "US Region" }, { label: "Partner" }] },
];
/** A built link goes to its page; one that isn't yet still takes focus (so the menu opens from the keyboard) but is marked disabled. */
const linkAttrs = (link: Link) =>
  link.href ? { href: link.href } : { "aria-disabled": "true", tabindex: 0, title: "Coming soon" };

const pillars = [
  {
    kicker: "Algorithmic Autonomy",
    headline: "Reclaim Your Feed",
    body: "Doomscrolling and outrage loops aren't accidents; they're business models. Platforms should give people native control over how their apps work, and switch the defaults to ones built for wellbeing, not engagement.",
  },
  {
    kicker: "Sandboxes for Independent Safety Labs",
    headline: "Evidence-Based Regulation",
    body: "Regulators shouldn't have to guess what works, or take Big Tech's word for it. Give researchers and policy teams direct API sandbox access to test UX safeguards in live environments, so decisions rest on evidence and benefit everyone.",
  },
  {
    kicker: "Building Real Proofs (Velo)",
    headline: "Tools, Not Just Talk",
    body: "We use public APIs to build working alternatives like Velo, showing exactly how platforms can put user control, intentional viewing and sanity back into the front-end experience.",
  },
];

const ageChecks = {
  today: {
    title: "Upload-your-ID checks",
    points: [
      "A passport, licence or face scan for every site",
      "Stored on servers you'll never see",
      "One breach, and it's out there for good",
    ],
  },
  better: {
    title: "On-device age checks",
    points: [
      "Checked once, then kept on your own device",
      "Unlocked with your passkey, fingerprint or face",
      "Sites only learn “old enough”: nothing to leak",
    ],
  },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fix the Web</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <!--
      Takes over from the big logo once you scroll: the whole header fades in, its logo's spider
      sitting in .brand-spider (drawn by the badge rig below). data-spider-ignore: presses here never
      grab or pluck the string.
    -->
    <header class="header" data-spider-ignore inert>
      <div class="header-inner">
        <a class="brand" href="#top" aria-label="Fix the Web: back to the top">
          <span class="brand-spider"></span>
          <span class="brand-text">
            <strong class="brand-initials">FTW</strong>
            <span class="brand-name">Fix The Web</span>
          </span>
        </a>
        <nav class="nav" aria-label="Main">
          <ul class="nav-list">
            {
              nav.map((section) => (
                <li class="nav-item">
                  <a class="nav-top" {...linkAttrs(section)}>
                    {section.label}
                  </a>
                  <div class="nav-drop">
                    <ul class="nav-menu">
                      {section.links.map((link) => (
                        <li>
                          <a {...linkAttrs(link)}>{link.label}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero" id="top">
        <h1><Logo class="logo" role="img" aria-label="Fix the Web" /></h1>
        <p>Coming soon.</p>
      </section>

      <section class="section intro">
        <h2 class="punchline">The web isn't broken by accident. <em>Let's fix it on purpose.</em></h2>
        <p class="lede">
          Feeds engineered to keep you scrolling, safeguards nobody's allowed to test, and age checks that stockpile
          our faces and IDs. None of it has to work this way.
        </p>
      </section>

      <section class="section">
        <p class="eyebrow">What we're pushing for</p>
        <h2>Three ways to fix it</h2>
        <div class="cards">
          {
            pillars.map((pillar) => (
              <article class="card">
                <p class="card-kicker">{pillar.kicker}</p>
                <h3>{pillar.headline}</h3>
                <p>{pillar.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section split">
        <div>
          <p class="eyebrow">Age checks</p>
          <h2>Prove your age, not your identity</h2>
          <p>
            Countries are rushing to require age checks online, and most end the same way: upload your ID or scan your
            face, and trust it's stored safely until the next data breach.
          </p>
          <p>
            There's a better way. Verify once, then keep your age as a credential on your own phone or computer,
            unlocked by the passkey, fingerprint or face unlock you already use. Sites get a simple yes or no, and
            never see your ID or your face, so there's nothing of yours to leak.
          </p>
        </div>
        <div class="compare">
          <div class="compare-card">
            <h3>{ageChecks.today.title}</h3>
            <ul>{ageChecks.today.points.map((point) => <li>{point}</li>)}</ul>
          </div>
          <div class="compare-card better">
            <h3>{ageChecks.better.title}</h3>
            <ul>{ageChecks.better.points.map((point) => <li>{point}</li>)}</ul>
          </div>
        </div>
      </section>

      <section class="section stance">
        <p class="eyebrow">Where we stand</p>
        <h2>Open by default. Better by design.</h2>
        <p>
          Fix the Web stands for an open internet that isn't built on surveillance. We're not asking for the web to be
          locked down. We're asking platforms to hand people real tools, and then give them every reason to use them:
          recommending healthier features at the right moment, putting controls where people will actually find them,
          and making the better choice the easy one.
        </p>
      </section>
    </main>

    <SpiderString anchor=".logo [data-glyph='b']" />
    <SpiderString badge=".brand-spider" />
  </body>
</html>

<script>
  // Scrolling away from the big logo fades the header (with its own spider) in, by the time the
  // logo's halfway gone. --swap goes 0 → 1 over that.
  const hero = document.querySelector<HTMLElement>(".hero");
  const header = document.querySelector<HTMLElement>(".header");
  let showing: boolean | null = null;
  const update = () => {
    if (!hero || !header) return;
    const swap = Math.min(1, Math.max(0, window.scrollY / (hero.offsetHeight * 0.5)));
    document.documentElement.style.setProperty("--swap", String(swap));
    // As soon as any of it shows, it can be used (and hovering it brings it fully in).
    if (swap > 0 !== showing) {
      showing = swap > 0;
      header.inert = !showing;
    }
  };
  addEventListener("scroll", update, { passive: true });
  addEventListener("resize", update);
  update();
</script>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fafaf7;
    --ink: #1b1e29;
    --muted: color-mix(in srgb, var(--ink) 60%, transparent);
    --line: color-mix(in srgb, var(--ink) 12%, transparent);
    --fill: color-mix(in srgb, var(--ink) 6%, transparent);
    /* Links that aren't built yet. */
    --unbuilt: color-mix(in srgb, var(--ink) 32%, transparent);
    /* The logo's green; darker on light, where the logo's own would be too faint as text. */
    --accent: #2b8666;
    /* Cards, a step up from the page. */
    --surface: #ffffff;
    /* The header's own colour, a step off the page's, so it reads as a bar over it. */
    --header-bg: #ecece4;
    --header-height: 76px;
    /* The page's content column, which the header lines up with. */
    --content-width: 960px;
    --gutter: 1.5rem;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1b1e29;
      --ink: #f2f2ee;
      --accent: #6ac7a7;
      --surface: #222633;
      --header-bg: #282c3b;
    }
  }
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 18px/1.5 system-ui, sans-serif;
  }
  main {
    /* Above the string and spider, which can pass behind it… */
    position: relative;
    z-index: 1;
    /* …but presses go through to the spider back there. */
    pointer-events: none;
  }
  main p,
  .section {
    pointer-events: auto;
  }

  /* ── The big logo ── */
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    padding: 2rem;
    box-sizing: border-box;
  }
  h1 {
    margin: 0;
  }
  .logo {
    display: block;
    width: min(80vw, 640px);
    height: auto;
  }

  /* ── The header: the logo on the left and the sections on the right, lined up with the content ── */
  .header {
    position: fixed;
    inset: 0 0 auto;
    /* Above the page; the badge spider (z-index 10) is drawn above this. */
    z-index: 5;
    /* Background and all: fades in as you scroll away from the big logo… */
    background: var(--header-bg);
    opacity: var(--swap, 0);
    transition: opacity 0.15s ease;
  }
  /* The header's spider fades in with it. */
  .spider-string[data-mode="badge"] {
    opacity: var(--swap, 0);
    transition: opacity 0.15s ease;
  }
  /* …and while you're over it, it's all the way in, part-way through the fade or not. */
  .header:hover,
  .header:focus-within,
  :root:has(.header:hover, .header:focus-within) .spider-string[data-mode="badge"] {
    opacity: 1;
  }
  /*
   * The same column as the page's content, so the logo starts where the headings do. The sections
   * sit in the middle of it: equal space either side keeps them centred whatever the logo's width.
   */
  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 2rem;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .brand {
    justify-self: start;
    display: flex;
    align-items: center;
    height: var(--header-height);
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }
  /* Just a space: the spider in it is drawn by the badge rig, sized to this width. */
  .brand-spider {
    width: 52px;
    height: 52px;
    flex: none;
  }
  .brand-text {
    display: grid;
    line-height: 1.1;
    white-space: nowrap;
  }
  .brand-initials {
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .brand-name {
    font-size: 0.75rem;
    color: var(--muted);
  }

  /*
   * ── Sections ──
   * Over the header (or tabbing into it), the bar grows taller and shows every section's links at
   * once, each under its heading.
   */
  .nav-list,
  .nav-menu {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Each column is as wide as its heading, so the headings are evenly spaced; the gap leaves room for
     a link longer than its heading (Press Center) to run on into it. */
  .nav-list {
    display: flex;
    gap: 2rem;
  }
  .nav-top {
    display: flex;
    align-items: center;
    height: var(--header-height);
    padding: 0 0.875rem;
    color: inherit;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  /* Rows 0fr → 1fr: the links' own height, eased open, so the bar grows to fit the longest list. Its
     width doesn't count towards the column's (contain), so the heading alone sets that. */
  .nav-drop {
    contain: inline-size;
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows 0.25s ease,
      opacity 0.2s ease,
      visibility 0.25s;
  }
  .header:hover .nav-drop,
  .header:focus-within .nav-drop {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
  }
  /* Clipped top to bottom while it opens, but free to run on sideways. */
  .nav-menu {
    overflow-x: visible;
    overflow-y: clip;
    min-height: 0;
  }
  .nav-menu li:last-child {
    padding-bottom: 1.25rem;
  }
  .nav-menu a {
    display: block;
    width: max-content;
    padding: 0.4rem 0.875rem;
    border-radius: 8px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .nav-menu a:hover,
  .nav-menu a:focus-visible {
    color: var(--ink);
    background: var(--fill);
  }
  /* Not built yet: greyed out, and no highlight, since it goes nowhere. */
  .nav a[aria-disabled="true"],
  .nav a[aria-disabled="true"]:hover,
  .nav a[aria-disabled="true"]:focus-visible {
    color: var(--unbuilt);
    background: none;
    cursor: default;
  }
  /* No room for the sections on a narrow screen: just the logo, until there's a menu for them. */
  @media (max-width: 760px) {
    .nav {
      display: none;
    }
  }

  /* ── Content ── */
  .section {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 5rem var(--gutter);
  }
  .section + .section {
    border-top: 1px solid var(--line);
  }
  .section h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .section p {
    max-width: 62ch;
    margin: 0 0 1rem;
    color: var(--muted);
  }
  .eyebrow,
  .card-kicker {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .section .eyebrow {
    margin-bottom: 0.75rem;
    color: var(--accent);
  }

  /* The punchline */
  .intro {
    padding-top: 6rem;
  }
  .section .punchline {
    max-width: 18ch;
    margin-bottom: 1.5rem;
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .punchline em {
    font-style: normal;
    color: var(--accent);
  }
  .section .lede {
    font-size: 1.25rem;
  }

  /* The three pillars */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .section .card-kicker {
    margin: 0;
    color: var(--accent);
    font-size: 0.75rem;
  }
  .card h3 {
    margin: 0 0 0.25rem;
    font-size: 1.375rem;
    line-height: 1.2;
  }
  .section .card p:last-child {
    margin: 0;
    font-size: 1rem;
  }

  /* Age checks: the idea beside the two ways side by side */
  .split {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 820px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
  .compare {
    display: grid;
    gap: 1rem;
  }
  .compare-card {
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .compare-card.better {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .compare-card h3 {
    margin: 0 0 0.75rem;
    font-size: 1rem;
  }
  .compare-card ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .compare-card li {
    display: flex;
    gap: 0.625rem;
  }
  .compare-card li::before {
    content: "✕";
    content: "✕" / "";
    flex: none;
    width: 1em;
    font-weight: 700;
    color: #d9534f;
  }
  .compare-card.better li::before {
    content: "✓";
    content: "✓" / "";
    color: var(--accent);
  }

  /* Where we stand */
  .section.stance {
    padding-bottom: 7rem;
  }
</style>

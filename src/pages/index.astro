---
import Logo from "../assets/brand/fixtheweb-logo.svg";
import SpiderString from "../components/SpiderString.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fix the Web</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <main>
      <h1><Logo class="logo" role="img" aria-label="Fix the Web" /></h1>
      <p>Coming soon.</p>
    </main>
    <SpiderString anchor=".logo [data-glyph='b']" />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fafaf7;
    --ink: #1b1e29;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1b1e29;
      --ink: #f2f2ee;
    }
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: var(--bg);
    color: var(--ink);
    font: 18px/1.5 system-ui, sans-serif;
  }
  main {
    text-align: center;
    padding: 2rem;
  }
  h1 {
    margin: 0;
  }
  .logo {
    display: block;
    width: min(80vw, 640px);
    height: auto;
  }
</style>

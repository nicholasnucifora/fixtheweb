---
import Logo from "../assets/brand/fixtheweb-logo.svg";

interface Props { page: "home" | "den" | "life" | "design" | "work" | "notes" | "archive" | "ideas" | "about" }
const { page } = Astro.props;
const nav = [
  { label: "Our work", href: "/work/villow", current: page === "work" },
  { label: "Ideas", href: "/ideas", current: page === "ideas" },
  { label: "About", href: "/about", current: page === "about" },
  { label: "Get involved", href: "/#get-involved", current: false },
];
---

<header class="header" data-spider-ignore data-page={page}>
  <div class="header-inner">
    <a class="brand" href={page === "home" ? "#top" : "/"} aria-label="Fix the Web: home">
      <Logo class="brand-logo" aria-hidden="true" />
    </a>
    <nav class="nav" aria-label="Main">
      <ul class="nav-list">
        {nav.map(link => <li><a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a></li>)}
      </ul>
    </nav>
    <div class="header-tools">
      <button type="button" class="color-mode-toggle" data-color-mode-toggle aria-label="Switch colour mode" aria-pressed="false">
        <svg class="mode-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></svg>
        <svg class="mode-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 15.3A8.5 8.5 0 0 1 8.7 4 8.5 8.5 0 1 0 20 15.3Z"/></svg>
      </button>
      <a class="den-link" href="/old-pages" aria-current={page === "archive" ? "page" : undefined}>Old pages</a>
      {page === "home" && <button type="button" class="design-link" data-design-toggle aria-expanded="false" aria-controls="home-design-panel">Design <span aria-hidden="true">＋</span></button>}
      <details class="mobile-nav">
        <summary aria-label="Open navigation">Menu</summary>
        <nav aria-label="Mobile">
          {nav.map(link => <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>)}
          <a href="/notes/design-and-access">Design &amp; access</a>
          <a href="/#approach">Our approach</a>
          <a href="/old-pages">Old pages</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".header");
  const updateHeader = () => {
    if (!header) return;
    const opacity = header.dataset.page === "home" ? Math.min(1, window.scrollY / 90) : 1;
    header.style.setProperty("--header-opacity", String(opacity));
    document.documentElement.toggleAttribute("data-header-scrolled", window.scrollY > 90);
  };
  addEventListener("scroll", updateHeader, { passive: true });
  updateHeader();
  const menus = [...document.querySelectorAll<HTMLDetailsElement>(".header details")];
  for (const menu of menus) {
    menu.addEventListener("toggle", () => {
      if (menu.open) for (const other of menus) if (other !== menu) other.open = false;
    });
  }
  document.addEventListener("click", event => {
    if (event.target instanceof Node && !header?.contains(event.target)) menus.forEach(menu => menu.open = false);
  });
  document.addEventListener("keydown", event => {
    if (event.key !== "Escape") return;
    for (const menu of menus) if (menu.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
</script>

<style is:global>
  .header { position: fixed; inset: 0 0 auto; z-index: 30; isolation: isolate; }
  .header::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--header-bg); border-bottom: 1px solid var(--line); opacity: var(--header-opacity, 0); transition: opacity .15s ease; }
  .header:has(details[open])::before { opacity: 1; }
  .header-inner { min-height: var(--header-height); padding: 0 clamp(18px, 2.5vw, 40px); display: flex; align-items: center; gap: 28px; }
  .brand { display: flex; align-items: center; flex: none; gap: 9px; color: var(--ink); min-height: 48px; text-decoration: none; }
  .brand-logo { display: block; width: 178px; height: auto; }
  .nav { margin-inline: auto; }
  .nav-list { display: flex; gap: 24px; list-style: none; padding: 0; margin: 0; }
  .nav-list > li > a { display: block; padding-block: 12px; color: var(--ink); font-size: 15px; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .nav-list > li > a:hover, .nav-list > li > a[aria-current] { color: var(--accent); text-decoration: underline; text-underline-offset: 6px; }
  .nav-item { position: relative; }
  .header summary { list-style: none; cursor: pointer; font-size: 15px; font-weight: 800; min-height: 44px; display: flex; align-items: center; gap: 7px; }
  .header summary::-webkit-details-marker { display: none; }
  .header summary span { font-size: 13px; color: var(--muted); }
  .nav-menu, .mobile-nav nav { position: absolute; top: calc(100% + 8px); background: var(--surface); border: 1px solid var(--line); padding: 12px; margin: 0; list-style: none; min-width: 185px; border-radius: 20px; box-shadow: 0 12px 32px #00000012; }
  .nav-menu a, .mobile-nav nav a { display: block; padding: 9px 12px; border-radius: 12px; color: var(--ink); text-decoration: none; font-size: 15px; white-space: nowrap; }
  .nav-menu a:hover, .mobile-nav nav a:hover { background: var(--fill); }
  .nav-menu a[aria-disabled="true"] { color: var(--unbuilt); background: none; cursor: default; }
  .header-tools { display: flex; align-items: center; gap: 20px; }
  .color-mode-toggle { display: grid; place-items: center; width: 40px; height: 40px; flex: none; border: 1px solid var(--line); border-radius: 50%; background: transparent; color: var(--ink); cursor: pointer; }
  .color-mode-toggle:hover { background: var(--fill); }
  .color-mode-toggle svg { width: 20px; height: 20px; }
  .mode-sun { display: none; }
  [data-color-mode="dark"] .mode-sun { display: block; }
  [data-color-mode="dark"] .mode-moon { display: none; }
  .header-tools > a { font-size: 14px; font-weight: 800; text-decoration: none; color: var(--ink); white-space: nowrap; }
  .header-tools .design-link { border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px; background: transparent; color: var(--ink); font: 800 14px var(--body-font); white-space: nowrap; cursor: pointer; }
  .header-tools .design-link:hover, .design-link[aria-expanded="true"] { background: var(--fill); }
  .header-tools a:hover, .header-tools a[aria-current] { color: var(--accent); }
  .mobile-nav { display: none; position: relative; }
  .mobile-nav nav { right: 0; }
  .header :focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; border-radius: 8px; }
  @media (max-width: 1050px) { .nav-list { gap: 12px; } .header-tools { gap: 12px; } .den-link { display: none; } }
  @media (max-width: 850px) { .nav { display: none; } .header-tools { margin-left: auto; } .mobile-nav { display: block; } }
  @media (max-width: 550px) { .brand-logo { width: 136px; } .header-inner { gap: 10px; padding-inline: 16px; } .header-tools { gap: 10px; } .header-tools .design-link { padding: 7px 10px; } .header summary { font-size: 13px; } }
  @media (max-width: 380px) { .header-inner { padding-inline: 12px; gap: 8px; } .brand-logo { width: 114px; } .header-tools { gap: 6px; } .header-tools .design-link { padding: 7px 9px; font-size: 12px; } .color-mode-toggle { width: 34px; height: 34px; } }
  @media (prefers-reduced-motion: reduce) { .header::before { transition: none; } }
</style>

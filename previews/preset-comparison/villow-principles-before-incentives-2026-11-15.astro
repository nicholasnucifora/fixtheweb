  .choice-branches::after { content: ''; position: absolute; top: 0; left: 50%; height: 30px; border-left: 1.5px solid var(--accent); }
  .choice-branches > span { padding: 10px 4px; background: var(--surface); color: var(--accent); border: 1px solid var(--line); border-radius: 9px; font-size: .85rem; line-height: 1.5; font-weight: 800; text-align: center; }
  .goal-caption { margin: auto 0 0; color: var(--muted); font-size: .9rem; line-height: 1.65; text-align: center; }

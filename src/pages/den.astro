---
import SpiderString from "../components/SpiderString.astro";
import Base from "../layouts/Base.astro";
import { SCENES } from "../scripts/den/scenes";
import { AMOUNTS, SPEEDS } from "../scripts/den/settings";
import { PALETTE, PATTERNS, SKINS, SLOTS, THREADS, unlockLabel, type Slot } from "../scripts/spider-string/wardrobe";

/**
 * The Spider Den, in two views. Dress up: the picked spider hanging from a web, with a wardrobe to
 * dress it up. The den: all your spiders living on webs across the page (src/scripts/den/), with the
 * same wardrobe in a drawer. The wardrobe is built from the catalogue in wardrobe.ts;
 * src/scripts/den.ts makes it all work.
 */

const tabs: { id: string; label: string; shelves?: Slot[] }[] = [
  { id: "hats", label: "Hats", shelves: ["hat"] },
  { id: "face", label: "Face", shelves: ["eyes", "face"] },
  { id: "clothes", label: "Clothes", shelves: ["outfit", "back", "feet"] },
  { id: "costumes", label: "Costumes", shelves: ["costume"] },
  { id: "colours", label: "Colours" },
  { id: "snacks", label: "Snacks & tricks" },
];

const snacks = [
  { id: "fly", label: "Fly" },
  { id: "ladybird", label: "Ladybird" },
  { id: "moth", label: "Moth" },
  { id: "cookie", label: "Cookie" },
];
const tricks = [
  { id: "dropIn", label: "Abseil in" },
  { id: "idleLegs", label: "Stretch" },
  { id: "blink", label: "Blink" },
];
const moods = [
  { id: "faceHappy", label: "Happy" },
  { id: "faceExcited", label: "Excited" },
  { id: "faceSmug", label: "Smug" },
  { id: "faceSurprised", label: "Surprised" },
  { id: "faceAngry", label: "Grumpy" },
  { id: "faceDizzy", label: "Dizzy" },
  { id: "faceAsleep", label: "Sleepy" },
];
/** Items earned by feeding it, for the progress list. */
const snackUnlocks = (Object.keys(SLOTS) as Slot[]).flatMap((slot) =>
  SLOTS[slot].items.flatMap((item) => (item.unlock?.kind === "snacks" ? [{ slot, item, count: item.unlock.count }] : [])),
);

/**
 * The web the spider hangs from: threads out from a hub to the stage's edges, and rings between
 * them that sag toward the hub, a little uneven like the real thing. Drawn in a 400×240 box that
 * stretches across the top of the stage; the hub is where the thread hangs from (.hook).
 */
const HUB = [200, 80];
const web = (() => {
  const [hx, hy] = HUB;
  const angles = [-172, -148, -122, -98, -74, -50, -26, -4, 22, 48, 72, 108, 132, 158].map((a) => (a * Math.PI) / 180);
  const reach = angles.map((a) => {
    const dx = Math.cos(a);
    const dy = Math.sin(a);
    const tx = dx > 0 ? (400 - hx) / dx : dx < 0 ? -hx / dx : Infinity;
    const ty = dy > 0 ? (240 - hy) / dy : dy < 0 ? -hy / dy : Infinity;
    return Math.min(tx, ty);
  });
  const at = (i: number, r: number) => [hx + Math.cos(angles[i]) * r, hy + Math.sin(angles[i]) * r].map((v) => +v.toFixed(1));
  const radials = angles.map((_, i) => `M${hx} ${hy}L${at(i, reach[i]).join(" ")}`).join("");
  let rings = "";
  for (const [k, radius] of [10, 20, 32, 46, 62, 80, 101, 125, 152, 182, 216].entries()) {
    for (let i = 0; i < angles.length; i++) {
      const j = (i + 1) % angles.length;
      // Leave a gap under the hub, where the thread comes down.
      if (angles[i] < Math.PI / 2 && angles[j] > Math.PI / 2) continue;
      const ri = radius * (1 + 0.05 * Math.sin(i * 1.7 + k));
      const rj = radius * (1 + 0.05 * Math.sin(j * 1.7 + k));
      if (ri > reach[i] * 0.97 || rj > reach[j] * 0.97) continue;
      const [ax, ay] = at(i, ri);
      const [bx, by] = at(j, rj);
      const sag = 0.86;
      const cx = +(hx + ((ax + bx) / 2 - hx) * sag).toFixed(1);
      const cy = +(hy + ((ay + by) / 2 - hy) * sag).toFixed(1);
      rings += `M${ax} ${ay}Q${cx} ${cy} ${bx} ${by}`;
    }
  }
  return { radials, rings };
})();

const speedLabel = (speed: number) => ({ 0.25: "¼×", 0.5: "½×" })[speed as 0.25 | 0.5] ?? `${speed}×`;
const amounts = Object.entries(AMOUNTS) as [keyof typeof AMOUNTS, { label: string }][];

const gear = `<svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M8.6 1.5h2.8l.4 2.2c.5.2 1 .5 1.4.8l2.1-.8 1.4 2.4-1.7 1.4a5.6 5.6 0 0 1 0 1.6l1.7 1.4-1.4 2.4-2.1-.8c-.4.3-.9.6-1.4.8l-.4 2.2H8.6l-.4-2.2c-.5-.2-1-.5-1.4-.8l-2.1.8-1.4-2.4L5 10.8a5.6 5.6 0 0 1 0-1.6L3.3 7.8l1.4-2.4 2.1.8c.4-.3.9-.6 1.4-.8l.4-2.2ZM10 12.6a2.6 2.6 0 1 0 0-5.2 2.6 2.6 0 0 0 0 5.2Z"/></svg>`;
const ghost = `<svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M10 1.5c-3.6 0-6 2.7-6 6.2v10.1l2-1.4 2 1.4 2-1.4 2 1.4 2-1.4 2 1.4V7.7c0-3.5-2.4-6.2-6-6.2ZM7.6 9.3a1.2 1.2 0 1 0 0-2.4 1.2 1.2 0 0 0 0 2.4Zm4.8 0a1.2 1.2 0 1 0 0-2.4 1.2 1.2 0 0 0 0 2.4Z"/></svg>`;

const lock = `<svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true"><path fill="currentColor" d="M4.5 7V5a3.5 3.5 0 1 1 7 0v2h.5a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h.5Zm1.75 0h3.5V5a1.75 1.75 0 1 0-3.5 0v2Z"/></svg>`;
---

<Base title="Spider Den · Fix the Web" page="den">
  <main class="den" data-den-view="dress" data-wardrobe="open" data-tuner>
    <div class="den-bar" data-spider-ignore>
      <div class="view-switch" role="group" aria-label="View">
        <button type="button" data-den-show="dress" aria-pressed="true">Dress up</button>
        <button type="button" data-den-show="den" aria-pressed="false">The den</button>
      </div>
      <button class="chip bar-button" type="button" data-den-wardrobe-toggle aria-expanded="false">Wardrobe</button>
      <div class="view-switch scene-switch" role="group" aria-label="Scene">
        {
          Object.entries(SCENES).map(([id, { label }]) => (
            <button type="button" data-den-scene={id} aria-pressed="false">
              {label}
            </button>
          ))
        }
      </div>
      <button
        class="chip bar-button bar-icon"
        type="button"
        data-den-settings-toggle
        aria-expanded="false"
        aria-controls="den-settings"
        title="Den settings"
      >
        <Fragment set:html={gear} />
        <span class="visually-hidden">Den settings</span>
      </button>
      <button class="chip bar-button bar-icon" type="button" data-den-cut aria-pressed="false" title="Cut threads: drag across the den" hidden>
        <span aria-hidden="true">✂</span>
        <span class="visually-hidden">Cut threads</span>
      </button>
      <div class="picker" role="group" aria-label="Your spiders" data-den-picker></div>
    </div>

    <div class="den-stage-col">
      <div class="den-intro">
        <p class="eyebrow">Spider Den</p>
        <h1>Dress up <span data-den-name>Webby</span></h1>
        <p class="lede" data-den-lede>
          The spider from our logo lives here. Give it a hat, pick its colours, feed it a snack. Whatever it wears here,
          it wears all over the site.
        </p>
      </div>
      <div class="stage">
        <svg class="web" viewBox="0 0 400 240" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="web-fade" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0.55" stop-color="#fff" />
              <stop offset="1" stop-color="#fff" stop-opacity="0" />
            </linearGradient>
            <mask id="web-mask" maskContentUnits="objectBoundingBox">
              <rect width="1" height="1" fill="url(#web-fade)" />
            </mask>
          </defs>
          <g mask="url(#web-mask)">
            <path d={web.radials} />
            <path d={web.rings} />
          </g>
        </svg>
        <span class="hook" data-den-hook></span>
        <div class="stage-slot" data-den-slot></div>
        <p class="stage-hint">Drag it, fling it, or drag a snack to its mouth.</p>
      </div>
    </div>

    <section class="wardrobe" data-spider-ignore aria-label="Wardrobe">
      <div class="wardrobe-head">
        <label class="name-field">
          <span>Name</span>
          <input data-den-name-input maxlength="24" value="Webby" placeholder="Pick a spider" autocomplete="off" spellcheck="false" />
        </label>
        <div class="head-actions">
          <button class="chip" type="button" data-den-surprise>Surprise me</button>
          <button class="chip" type="button" data-den-undress>Take it all off</button>
          <button class="chip drawer-close" type="button" data-den-wardrobe-close aria-label="Close the wardrobe">✕</button>
        </div>
      </div>

      <p class="nobody-hint">Drag anything here onto a spider to dress it up.</p>

      <div class="tabs" role="tablist" aria-label="Wardrobe">
        {
          tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              id={`den-tab-${tab.id}`}
              aria-controls={`den-panel-${tab.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
            >
              {tab.label}
            </button>
          ))
        }
      </div>

      {
        tabs
          .filter((tab) => tab.shelves)
          .map((tab, i) => (
            <div class="panel" role="tabpanel" id={`den-panel-${tab.id}`} aria-labelledby={`den-tab-${tab.id}`} hidden={i !== 0}>
              {tab.shelves!.map((slot) => (
                <section class="shelf">
                  <h2>{SLOTS[slot].label}</h2>
                  <div class="tiles">
                    <button type="button" class="tile" data-slot={slot} data-item="none" aria-pressed="false">
                      <canvas class="tile-art" data-view={slot} aria-hidden="true" />
                      <span class="tile-label">None</span>
                    </button>
                    {SLOTS[slot].items.map((item) => (
                      <button
                        type="button"
                        class="tile"
                        data-slot={slot}
                        data-item={item.id}
                        data-locked={item.unlock ? "" : undefined}
                        aria-pressed="false"
                      >
                        <canvas class="tile-art" data-view={slot} aria-hidden="true" />
                        <span class="tile-label">{item.label}</span>
                        {item.unlock && (
                          <span class="tile-lock" title={`Locked: ${unlockLabel(item.unlock)}`}>
                            <Fragment set:html={lock} />
                            <span class="visually-hidden">(locked: {unlockLabel(item.unlock)})</span>
                          </span>
                        )}
                      </button>
                    ))}
                  </div>
                  <div class="swatches" data-swatches={slot} role="group" aria-label={`${SLOTS[slot].label} colour`} hidden>
                    {Object.entries(PALETTE).map(([key, { label, color }]) => (
                      <button
                        type="button"
                        class="swatch"
                        data-slot={slot}
                        data-tint={key}
                        style={`--swatch: ${color}`}
                        aria-label={label}
                        title={label}
                        aria-pressed="false"
                      />
                    ))}
                  </div>
                </section>
              ))}
            </div>
          ))
      }

      <div class="panel" role="tabpanel" id="den-panel-colours" aria-labelledby="den-tab-colours" hidden>
        <p class="colour-lock" data-colour-lock hidden></p>
        <section class="shelf">
          <h2>Body</h2>
          <div class="tiles">
            {
              Object.entries(SKINS).map(([key, { label }]) => (
                <button type="button" class="tile" data-skin={key} aria-pressed="false">
                  <canvas class="tile-art" data-view="whole" aria-hidden="true" />
                  <span class="tile-label">{label}</span>
                </button>
              ))
            }
          </div>
        </section>
        <section class="shelf">
          <h2>Pattern</h2>
          <div class="tiles">
            {
              Object.entries(PATTERNS).map(([key, { label }]) => (
                <button type="button" class="tile" data-pattern={key} aria-pressed="false">
                  <canvas class="tile-art" data-view="whole" aria-hidden="true" />
                  <span class="tile-label">{label}</span>
                </button>
              ))
            }
          </div>
        </section>
        <section class="shelf">
          <h2>Thread</h2>
          <div class="threads">
            {
              Object.entries(THREADS).map(([key, { label, color }]) => (
                <button type="button" class="chip thread" data-thread={key} aria-pressed="false">
                  <span class="thread-line" data-kind={key} style={color ? `--thread: ${color}` : undefined} aria-hidden="true" />
                  {label}
                </button>
              ))
            }
          </div>
        </section>
      </div>

      <div class="panel" role="tabpanel" id="den-panel-snacks" aria-labelledby="den-tab-snacks" hidden>
        <section class="shelf">
          <h2>Snacks</h2>
          <div class="tiles snacks">
            {
              snacks.map((snack) => (
                <button type="button" class="tile" data-snack={snack.id}>
                  <canvas class="tile-art" data-icon={snack.id} aria-hidden="true" />
                  <span class="tile-label">{snack.label}</span>
                </button>
              ))
            }
          </div>
          <p class="shelf-note">
            <strong data-den-snack-count>0</strong> <span data-den-snack-word>snacks</span> eaten. Each one makes it a little
            bigger, for a while.
          </p>
          <ul class="progress">
            {
              snackUnlocks.map(({ slot, item, count }) => (
                <li data-progress-slot={slot} data-progress-item={item.id} data-count={count}>
                  <span class="progress-label">{item.label}</span>
                  <span class="progress-bar" aria-hidden="true">
                    <span />
                  </span>
                  <span class="progress-count">0 / {count}</span>
                </li>
              ))
            }
          </ul>
        </section>
        <section class="shelf">
          <h2>Tricks</h2>
          <div class="chips">
            {
              tricks.map((trick) => (
                <button type="button" class="chip" data-play={trick.id}>
                  {trick.label}
                </button>
              ))
            }
            <button type="button" class="chip" data-den-reset>Back to normal size</button>
          </div>
        </section>
        <section class="shelf">
          <h2>Moods</h2>
          <div class="chips">
            {
              moods.map((mood) => (
                <button type="button" class="chip" data-play={mood.id}>
                  {mood.label}
                </button>
              ))
            }
          </div>
        </section>
        <form class="code-form wardrobe-code" data-den-code>
        <label for="den-code-wardrobe">Have a code?</label>
        <div class="code-row">
          <input id="den-code-wardrobe" name="code" maxlength="32" placeholder="Enter a code" autocomplete="off" spellcheck="false" />
          <button class="chip" type="submit">Redeem</button>
        </div>
        <p class="code-note" data-code-note aria-live="polite"></p>
        </form>
      </div>

      <p class="notice" data-den-notice aria-live="polite">Saved in this browser: it wears this on every page.</p>
    </section>

    <!-- The den: webs across the whole page, and everyone living on them. -->
    <div class="den-world" data-den-world aria-hidden="true">
      <canvas></canvas>
    </div>

    <aside class="den-card" data-den-card data-spider-ignore aria-label="Picked spider" hidden>
      <button class="card-close" type="button" data-card-close aria-label="Close (let go of this spider)">✕</button>
      <canvas class="card-portrait" data-card-portrait aria-hidden="true"></canvas>
      <div class="card-body">
        <p class="card-name">
          <strong data-card-name>Webby</strong>
          <span class="card-main" data-card-main title="The one on the logo and in the header">★ Main spider</span>
        </p>
        <p class="card-age" data-card-age>Grown up</p>
        <p class="card-family" data-card-family hidden></p>
        <div class="meter" data-card-growth>
          <span class="meter-label">Growing</span>
          <span class="meter-bar" aria-hidden="true"><span></span></span>
          <span class="meter-value"></span>
        </div>
        <div class="meter" data-card-fullness>
          <span class="meter-label">Tummy</span>
          <span class="meter-bar" aria-hidden="true"><span></span></span>
          <span class="meter-value"></span>
        </div>
      </div>
      <ul class="card-traits" data-card-traits aria-label="What it's like"></ul>
      <details class="card-genes" data-card-genes hidden>
        <summary>Genes and personality <span>testing</span></summary>
        <div class="genes-grid" data-genes-grid></div>
        <div class="genes-actions">
          <button class="chip" type="button" data-genes-reroll>Re-roll everything</button>
          <button class="chip" type="button" data-genes-colours>Re-roll colours</button>
          <button class="chip" type="button" data-genes-old>Make old</button>
          <button class="chip" type="button" data-genes-starve>Starve</button>
        </div>
      </details>
      <div class="card-actions">
        <button class="chip" type="button" data-card-dress>Dress up</button>
        <button class="chip" type="button" data-card-feed>Feed</button>
        <button class="chip" type="button" data-card-lay>Lay eggs</button>
        <button class="chip" type="button" data-card-make-main>Make main spider</button>
      </div>
      <p class="card-note" data-card-note aria-live="polite">
        Fling them, dangle them, snap their strings. Drag clothes from the wardrobe onto anyone.
      </p>
    </aside>

    <section class="den-settings" id="den-settings" data-den-settings data-spider-ignore aria-label="Den settings" hidden>
      <div class="panel-head">
        <strong>The den</strong>
        <button class="card-close" type="button" data-den-settings-close aria-label="Close den settings">✕</button>
      </div>
      <div class="setting">
        <span class="setting-label" id="den-set-speed">Time</span>
        <div class="view-switch" role="group" aria-labelledby="den-set-speed">
          {
            SPEEDS.map((speed) => (
              <button type="button" data-den-speed={speed} aria-pressed="false">
                {speedLabel(speed)}
              </button>
            ))
          }
        </div>
        <p class="setting-note">Speeds up (or slows down) the den's day, and life with it: hunger, growing up, flies and predators coming by. Everyone still moves about at nearly their usual pace.</p>
        <p class="setting-clock" data-den-clock></p>
      </div>
      <div class="setting">
        <span class="setting-label" id="den-set-flies">Flies</span>
        <div class="view-switch" role="group" aria-labelledby="den-set-flies">
          {
            amounts.map(([key, { label }]) => (
              <button type="button" data-den-flies={key} aria-pressed="false">
                {label}
              </button>
            ))
          }
        </div>
      </div>
      <div class="setting">
        <span class="setting-label" id="den-set-predators">Predators</span>
        <div class="view-switch" role="group" aria-labelledby="den-set-predators">
          {
            amounts.map(([key, { label }]) => (
              <button type="button" data-den-predators={key} aria-pressed="false">
                {label}
              </button>
            ))
          }
        </div>
        <p class="setting-note">Birds, frogs and pirate spiders. Grab a spider to save it, or press a predator to shoo it.</p>
      </div>
      <label class="setting setting-toggle">
        <input type="checkbox" data-den-fights />
        <span>
          <span class="setting-label">Starving spiders fight</span>
          <span class="setting-note">And sometimes eat each other.</span>
        </span>
      </label>
      <form class="code-form" data-den-code>
        <label for="den-code-settings">Have a code?</label>
        <div class="code-row">
          <input id="den-code-settings" name="code" maxlength="32" placeholder="Enter a code" autocomplete="off" spellcheck="false" />
          <button class="chip" type="submit">Redeem</button>
        </div>
        <p class="code-note" data-code-note aria-live="polite"></p>
      </form>
    </section>

    <div class="den-deaths" data-den-deaths data-spider-ignore>
      <button class="deaths-toggle" type="button" data-deaths-toggle aria-expanded="false" aria-controls="den-deaths-panel">
        <Fragment set:html={ghost} />
        <span class="deaths-label">Deaths</span>
        <span class="deaths-badge" data-deaths-badge hidden>0</span>
      </button>
      <section class="deaths-panel" id="den-deaths-panel" data-deaths-panel aria-label="Deaths" hidden>
        <div class="panel-head">
          <strong>Deaths</strong>
          <span class="deaths-count" data-deaths-count></span>
          <button class="chip deaths-clear" type="button" data-deaths-clear>Clear</button>
          <button class="card-close" type="button" data-deaths-close aria-label="Close the deaths log">✕</button>
        </div>
        <p class="deaths-empty" data-deaths-empty>Nobody's died yet. Keep them fed, and keep an eye out for birds.</p>
        <ol class="deaths-list" data-deaths-list></ol>
      </section>
    </div>
  </main>

  <SpiderString stage="[data-den-slot]" hook="[data-den-hook]" tryOn />
</Base>

<script>
  import { mountDen } from "../scripts/den";
  mountDen();
</script>

<style is:global>
  .den {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 1.5rem 2.5rem;
    align-items: start;
    max-width: 1120px;
    margin: 0 auto;
    padding: calc(var(--header-height) + 2.5rem) var(--gutter) 5rem;
    box-sizing: border-box;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .den :is(button, input):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ── The spider, hanging from its web ── */
  .den-stage-col {
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
  }
  .den .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .den h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }
  .den h1 [data-den-name] {
    color: var(--accent);
  }
  .den .lede {
    max-width: 42ch;
    margin: 0 0 1.5rem;
    color: var(--muted);
  }
  .stage {
    position: relative;
    height: clamp(340px, calc(100svh - var(--header-height) - 20rem), 540px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
  }
  .web {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: 240px;
    color: var(--ink);
  }
  .web path {
    fill: none;
    stroke: currentColor;
    stroke-opacity: 0.2;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  /* The web's hub (see HUB): where the thread hangs from. */
  .hook {
    position: absolute;
    left: 50%;
    top: 80px;
  }
  /* Where the spider rests, and how big it is: the rig sizes it to this width. --grow: how grown the picked spider is. */
  .stage-slot {
    position: absolute;
    left: 50%;
    top: 62%;
    width: calc(clamp(120px, 40%, 210px) * var(--grow, 1));
    aspect-ratio: 596 / 401;
    transform: translate(-50%, -50%);
  }
  .stage-hint {
    position: absolute;
    inset: auto 1rem 0.875rem;
    margin: 0;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* ── The wardrobe ── */
  .wardrobe {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
  }
  .wardrobe-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .name-field {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: 700;
  }
  .name-field input {
    width: 11ch;
    padding: 0.45rem 0.75rem;
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .head-actions,
  .chips,
  .threads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    font: 600 0.875rem/1 system-ui, sans-serif;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
  }
  .chip:hover {
    border-color: var(--accent);
  }
  .chip:active {
    background: var(--fill);
  }
  .chip[aria-pressed="true"] {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .tabs {
    display: flex;
    gap: 0.25rem;
    padding: 0 0.75rem;
    overflow-x: auto;
    border-bottom: 1px solid var(--line);
    scrollbar-width: none;
  }
  .tabs [role="tab"] {
    flex: none;
    padding: 1rem 0.625rem 0.875rem;
    font: 700 0.8125rem/1 system-ui, sans-serif;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    white-space: nowrap;
  }
  .tabs [role="tab"]:hover {
    color: var(--ink);
  }
  .tabs [role="tab"][aria-selected="true"] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .panel {
    padding: 1.25rem;
  }
  .shelf + .shelf {
    margin-top: 1.75rem;
  }
  .shelf h2 {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
    gap: 0.5rem;
  }
  .tile {
    position: relative;
    display: grid;
    gap: 0.25rem;
    padding: 0.5rem 0.375rem 0.5rem;
    font: 600 0.75rem/1.2 system-ui, sans-serif;
    color: var(--ink);
    text-align: center;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 14px;
    cursor: pointer;
  }
  .tile:hover {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .tile[aria-pressed="true"] {
    background: color-mix(in srgb, var(--accent) 9%, var(--bg));
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }
  .tile-art {
    display: block;
    width: 100%;
    height: 68px;
  }
  .tile[data-locked] .tile-art {
    opacity: 0.6;
  }
  .tile-lock {
    position: absolute;
    top: 0.375rem;
    right: 0.375rem;
    display: none;
    place-items: center;
    width: 20px;
    height: 20px;
    color: var(--bg);
    background: var(--ink);
    border-radius: 50%;
  }
  .tile[data-locked] .tile-lock {
    display: grid;
  }
  .snacks .tile-art {
    height: 44px;
  }

  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.875rem;
  }
  .swatch {
    width: 28px;
    height: 28px;
    padding: 0;
    background: var(--swatch);
    border: 2px solid var(--surface);
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--line);
    cursor: pointer;
  }
  .swatch[aria-pressed="true"] {
    box-shadow: 0 0 0 2px var(--accent);
  }
  .thread-line {
    width: 1.5rem;
    height: 3px;
    background: var(--thread, var(--ink));
    border-radius: 2px;
  }
  .thread-line[data-kind="rainbow"] {
    background: linear-gradient(90deg, #e8705a, #f0b43c, #6ac7a7, #5b9bd5, #7a5aa6);
  }

  .shelf-note {
    margin: 0.875rem 0 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .shelf-note strong {
    color: var(--ink);
  }
  .progress {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
  }
  .progress li {
    display: grid;
    grid-template-columns: 7rem 1fr 3.5rem;
    align-items: center;
    gap: 0.75rem;
  }
  .progress-bar {
    height: 6px;
    overflow: hidden;
    background: var(--fill);
    border-radius: 3px;
  }
  .progress-bar span {
    display: block;
    width: var(--done, 0%);
    height: 100%;
    background: var(--accent);
    border-radius: inherit;
    transition: width 0.3s ease;
  }
  .progress-count {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .notice {
    margin: 0;
    padding: 0.875rem 1.25rem;
    font-size: 0.875rem;
    color: var(--muted);
    border-top: 1px solid var(--line);
  }
  .notice strong {
    color: var(--ink);
  }

  /* ── Views, and your spiders ── */
  .den-bar {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .view-switch {
    display: flex;
    flex: none;
    padding: 3px;
    background: var(--fill);
    border-radius: 999px;
  }
  .view-switch button {
    padding: 0.5rem 0.95rem;
    font: 700 0.8125rem/1 system-ui, sans-serif;
    color: var(--muted);
    background: none;
    border: none;
    border-radius: 999px;
    cursor: pointer;
  }
  .view-switch button:hover {
    color: var(--ink);
  }
  .view-switch button[aria-pressed="true"] {
    color: var(--ink);
    background: var(--surface);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
  }
  .picker {
    display: flex;
    gap: 0.25rem;
    min-width: 0;
    padding: 2px;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .picker-spider {
    position: relative;
    display: grid;
    justify-items: center;
    flex: none;
    width: 3.5rem;
    padding: 0.2rem 0.1rem 0.25rem;
    font: 600 0.6875rem/1.1 system-ui, sans-serif;
    color: var(--muted);
    background: none;
    border: 1px solid transparent;
    border-radius: 12px;
    cursor: pointer;
  }
  .picker-spider:hover {
    color: var(--ink);
    background: var(--fill);
  }
  .picker-spider[aria-pressed="true"] {
    color: var(--ink);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
    border-color: var(--accent);
  }
  .picker-spider canvas {
    width: 2.75rem;
    height: 1.9rem;
  }
  .picker-name {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* The main spider: the one worn all over the site. */
  .picker-spider[data-main]::after {
    content: "★";
    position: absolute;
    top: 0;
    right: 0.2rem;
    font-size: 0.75rem;
    color: var(--accent);
  }

  /* ── The den ── */
  .den-world,
  .den-card,
  .bar-button,
  .scene-switch,
  .drawer-close {
    display: none;
  }
  .den[data-den-view="den"] .scene-switch {
    display: flex;
  }
  .den[data-den-view="den"] .bar-button {
    display: inline-flex;
    flex: none;
  }
  .bar-button[aria-expanded="true"] {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }
  :root[data-den-view="den"] {
    overflow: hidden;
  }
  .den[data-den-view="den"] {
    display: block;
    max-width: none;
    padding: 0;
  }
  .den[data-den-view="den"] .den-stage-col {
    display: none;
  }
  :root[data-den-view="den"] .spider-string[data-mode="stage"] {
    visibility: hidden;
  }
  .den[data-den-view="den"] .den-world {
    display: block;
    position: fixed;
    inset: var(--header-height) 0 0;
    z-index: 1;
    overflow: hidden;
  }
  .den-world canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }
  /* Floating over the den: the views and your spiders, the picked one's card, and the wardrobe drawer. */
  .den[data-den-view="den"] :is(.den-bar, .den-card, .wardrobe) {
    position: fixed;
    z-index: 3;
    box-shadow: 0 10px 34px rgb(0 0 0 / 0.14);
  }
  .den[data-den-view="den"] .den-bar {
    top: calc(var(--header-height) + 0.75rem);
    left: 0.75rem;
    max-width: calc(100vw - 9.5rem);
    gap: 0.5rem;
    padding: 0.3rem 0.4rem 0.3rem 0.3rem;
    box-sizing: border-box;
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    border: 1px solid var(--line);
    border-radius: 18px;
    backdrop-filter: blur(6px);
  }
  .den[data-den-view="den"][data-wardrobe="open"] .den-bar {
    max-width: calc(100vw - min(400px, 100vw - 1.5rem) - 10.25rem);
  }
  .den[data-den-view="den"] .wardrobe {
    top: calc(var(--header-height) + 0.75rem);
    right: 0.75rem;
    bottom: 0.75rem;
    width: min(400px, calc(100vw - 1.5rem));
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .den[data-den-view="den"][data-wardrobe="closed"] .wardrobe {
    display: none;
  }
  .den[data-den-view="den"] .drawer-close {
    display: inline-flex;
    padding-inline: 0.7rem;
  }
  .tile-ghost {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    pointer-events: none;
    /* A thin edge in the page's ink, so dark pieces still show on a dark page. */
    filter: drop-shadow(0 0 1px color-mix(in srgb, var(--ink) 60%, transparent)) drop-shadow(0 6px 12px rgb(0 0 0 / 0.25));
  }
  /* In the den with nobody picked, the wardrobe is for dragging from. */
  .nobody-hint {
    display: none;
    margin: 0;
    padding: 0.625rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .den[data-den-view="den"] .wardrobe[data-nobody] .nobody-hint {
    display: block;
  }
  .den[data-den-view="den"] .wardrobe[data-nobody] .tile {
    cursor: grab;
  }
  .den-card[hidden],
  .den[data-den-view="den"] .den-card[hidden] {
    display: none;
  }
  .card-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    font: 600 0.8125rem/1 system-ui, sans-serif;
    color: var(--muted);
    background: none;
    border: none;
    border-radius: 50%;
    cursor: pointer;
  }
  .card-close:hover {
    color: var(--ink);
    background: var(--fill);
  }
  .name-field input:disabled,
  .head-actions .chip:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .den[data-den-view="den"] .den-card {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.25rem 0.875rem;
    left: 0.75rem;
    bottom: 0.75rem;
    width: min(380px, calc(100vw - 1.5rem));
    padding: 0.875rem 1rem;
    box-sizing: border-box;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
  }
  .card-portrait {
    align-self: center;
    width: 5.5rem;
    height: 4rem;
  }
  .card-body p {
    margin: 0;
  }
  .card-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
    font-size: 1.0625rem;
    line-height: 1.2;
  }
  .card-name strong {
    overflow-wrap: anywhere;
  }
  .card-main {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    white-space: nowrap;
  }
  .den-card .card-age {
    margin-bottom: 0.4rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .meter {
    display: grid;
    grid-template-columns: 3.6rem 1fr 4.2rem;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
  }
  .meter + .meter {
    margin-top: 0.2rem;
  }
  .meter-label {
    color: var(--muted);
  }
  .meter-bar {
    height: 6px;
    overflow: hidden;
    background: var(--fill);
    border-radius: 3px;
  }
  .meter-bar span {
    display: block;
    width: var(--done, 0%);
    height: 100%;
    background: var(--accent);
    border-radius: inherit;
    transition: width 0.3s ease;
  }
  .meter[data-low] .meter-bar span {
    background: #e8705a;
  }
  .meter-value {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .card-actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.5rem;
  }
  .card-actions .chip {
    padding: 0.45rem 0.75rem;
    font-size: 0.8125rem;
  }
  .card-actions .chip[aria-disabled="true"] {
    color: var(--muted);
  }
  .card-note {
    grid-column: 1 / -1;
    margin: 0.4rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .card-note strong {
    color: var(--ink);
  }
  .den-card [hidden] {
    display: none;
  }

  /* ── Settings, the cut tool, and the deaths log ── */
  .den-settings,
  .den-deaths {
    display: none;
  }
  .bar-button[hidden],
  .den[data-den-view="den"] .bar-button[hidden] {
    display: none;
  }
  .bar-icon {
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    font-size: 1rem;
  }
  .bar-icon[aria-pressed="true"] {
    color: var(--bg);
    background: var(--ink);
    border-color: var(--ink);
  }
  .den[data-den-view="den"] .den-settings:not([hidden]) {
    display: grid;
    gap: 0.9rem;
    position: fixed;
    z-index: 4;
    top: calc(var(--header-height) + 4.1rem);
    left: 0.75rem;
    width: min(360px, calc(100vw - 1.5rem));
    max-height: calc(100svh - var(--header-height) - 5rem);
    overflow-y: auto;
    padding: 0.875rem 1rem 1rem;
    box-sizing: border-box;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: 0 10px 34px rgb(0 0 0 / 0.14);
  }
  .panel-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.75rem;
  }
  .panel-head strong {
    font-size: 1.0625rem;
  }
  .panel-head .card-close {
    position: static;
    margin-left: auto;
  }
  .setting {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
  }
  .setting-label {
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .setting-note {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .setting .view-switch {
    flex-wrap: wrap;
  }
  .setting-clock {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .setting-clock:empty {
    display: none;
  }
  .setting .view-switch button {
    padding: 0.45rem 0.75rem;
  }
  .setting-toggle {
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.625rem;
    cursor: pointer;
  }
  .setting-toggle > span {
    display: grid;
    gap: 0.15rem;
  }
  .setting-toggle input {
    width: 1.05rem;
    height: 1.05rem;
    margin: 0.05rem 0 0;
    accent-color: var(--accent);
  }
  .code-form {
    display: grid;
    gap: 0.4rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--line);
  }
  .code-form label {
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .code-row {
    display: flex;
    gap: 0.4rem;
  }
  .code-row input {
    flex: 1;
    min-width: 0;
    padding: 0.45rem 0.75rem;
    font: 600 0.875rem/1.2 system-ui, sans-serif;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .code-row input::placeholder {
    letter-spacing: normal;
    text-transform: none;
  }
  .code-note {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .code-note:empty {
    display: none;
  }
  .code-note[data-ok] {
    color: var(--accent);
    font-weight: 600;
  }
  .wardrobe-code {
    margin-top: 1.75rem;
  }

  .colour-lock {
    margin: 0 0 1.25rem;
    padding: 0.625rem 0.875rem;
    font-size: 0.8125rem;
    color: var(--muted);
    background: var(--fill);
    border-radius: 12px;
  }
  .colour-lock strong {
    color: var(--ink);
  }
  .colour-lock[hidden] {
    display: none;
  }
  .tile[aria-disabled="true"],
  .chip.thread[aria-disabled="true"] {
    cursor: not-allowed;
  }
  .tile[aria-disabled="true"]:not([aria-pressed="true"]) {
    opacity: 0.55;
  }

  .den[data-den-view="den"] .den-deaths {
    display: block;
    position: fixed;
    z-index: 4;
    top: calc(var(--header-height) + 0.75rem);
    right: 0.75rem;
  }
  .den[data-den-view="den"][data-wardrobe="open"] .den-deaths {
    right: calc(min(400px, 100vw - 1.5rem) + 1.5rem);
  }
  .deaths-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.75rem;
    padding: 0 0.9rem;
    font: 700 0.8125rem/1 system-ui, sans-serif;
    color: var(--ink);
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: 0 10px 34px rgb(0 0 0 / 0.14);
    backdrop-filter: blur(6px);
    cursor: pointer;
  }
  .deaths-toggle:hover,
  .deaths-toggle[aria-expanded="true"] {
    border-color: var(--accent);
  }
  .deaths-badge {
    min-width: 1.25rem;
    padding: 0.2rem 0.35rem;
    box-sizing: border-box;
    font-size: 0.6875rem;
    color: #fff;
    text-align: center;
    background: #d9473f;
    border-radius: 999px;
  }
  .deaths-badge[hidden] {
    display: none;
  }
  .deaths-toggle[data-new] {
    animation: deaths-nudge 0.6s ease;
  }
  @keyframes deaths-nudge {
    20%,
    60% {
      transform: rotate(-6deg);
    }
    40%,
    80% {
      transform: rotate(6deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .deaths-toggle[data-new] {
      animation: none;
    }
  }
  .deaths-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    width: min(360px, calc(100vw - 1.5rem));

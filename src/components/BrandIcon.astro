---
export type IconName = "spark" | "heart" | "clock" | "compass" | "leaf" | "people" | "chat" | "cursor";
interface Props { name: IconName; class?: string }
const { name, class: className } = Astro.props;
---
<svg class:list={["brand-icon", className]} viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "spark" && <><path class="icon-fill" d="M20 5c1 9 6 14 15 15-9 1-14 6-15 15-1-9-6-14-15-15 9-1 14-6 15-15Z"/><path d="m31 5 1 4 4 1M7 30l1 3 3 1"/></>}
  {name === "heart" && <path class="icon-fill" d="M20 33C13 28 5 22 5 15 5 5 16 4 20 12c4-8 15-7 15 3 0 7-8 13-15 18Z"/>}
  {name === "clock" && <><circle class="icon-fill" cx="20" cy="21" r="14"/><path d="M20 12v10l6 3M15 3h10"/></>}
  {name === "compass" && <><circle class="icon-fill" cx="20" cy="20" r="15"/><path d="m26 14-4 8-8 4 4-8 8-4Z"/></>}
  {name === "leaf" && <><path class="icon-fill" d="M32 6C12 4 5 13 9 25c12 6 23-1 23-19Z"/><path d="M7 34 25 16M12 29v-9M17 24h9"/></>}
  {name === "people" && <><circle class="icon-fill" cx="15" cy="13" r="6"/><path class="icon-fill" d="M4 33c0-14 22-14 22 0Z"/><path d="M27 8c8 0 9 11 1 12M30 24c5 1 7 4 7 9"/></>}
  {name === "chat" && <><path class="icon-fill" d="M6 7h28v21H19l-9 7v-7H6V7Z"/><path d="M13 15h14M13 21h8"/></>}
  {name === "cursor" && <><path class="icon-fill" d="m9 6 24 17-12 1-6 10L9 6Z"/><path d="m24 28 5 7M30 7l-3 4M36 14l-5 1"/></>}
</svg>
<style is:global>
  .brand-icon { width: 32px; height: 32px; flex: none; color: var(--accent); }
  .brand-icon .icon-fill { fill: color-mix(in srgb, var(--accent) 15%, transparent); }
  [data-design-icons="outline"] .brand-icon .icon-fill { fill: none; }
  [data-design-icons="chunky"] .brand-icon { stroke-width: 3.5; }
  [data-design-icons="chunky"] .brand-icon .icon-fill { fill: color-mix(in srgb, var(--accent) 28%, transparent); }
</style>

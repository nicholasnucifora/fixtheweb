---
/**
 * A string hanging from a logo glyph with a draggable spider on the end.
 * Behaviour and feel: src/scripts/spider-string/ (tune in config.ts, or live
 * by opening the page with ?tune).
 *
 * The string and spider are both drawn on the canvas; the bob element is the
 * spider's invisible grab target.
 *
 * Emits bubbling `spider:grab`, `spider:release` and `spider:pluck` events
 * from the root, and sets `data-spider` / `data-string` ("idle|hover|held")
 * on it for styling hooks.
 */
interface Props {
  /** CSS selector for the SVG glyph the string hangs from. */
  anchor: string;
}

const { anchor } = Astro.props;
---

<div class="spider-string" data-spider-string data-anchor={anchor} aria-hidden="true">
  <canvas class="canvas"></canvas>
  <div class="bob" data-bob></div>
</div>

<style>
  .spider-string {
    /* String colour: matches the logo ink in both themes. */
    color: var(--ink);
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 10;
    user-select: none;
    -webkit-user-select: none;
  }
  .canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Invisible grab target that follows the spider (the spider itself is drawn on the canvas). */
  .bob {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--bob-w, 0);
    height: var(--bob-h, 0);
    pointer-events: auto;
    touch-action: none;
    cursor: grab;
    -webkit-user-drag: none;
  }
  /* Bigger hit area than the spider itself (config bob.hitArea), so it's easy to grab. */
  .bob::after {
    content: "";
    position: absolute;
    inset: var(--bob-hit, -35%);
    border-radius: 50%;
  }
  /* Debug (Spidey → Debug → Show grab area). */
  .bob[data-show-hit]::after {
    outline: 1px dashed #ff5a5f;
  }
  /* The string is drawn on a canvas that ignores the pointer, so its cursors are set page-wide. */
  :global(html.spider-string-hover),
  :global(html.spider-string-hover *) {
    cursor: grab !important;
  }
  :global(html.spider-held),
  :global(html.spider-held *) {
    cursor: grabbing !important;
    user-select: none;
    -webkit-user-select: none;
  }
</style>

<script>
  import { mountAll } from "../scripts/spider-string";
  mountAll();
</script>

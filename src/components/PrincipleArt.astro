---
interface Props { theme: number; }
const { theme } = Astro.props;
---

<div class:list={['principle-art', `art-${theme}`]} aria-hidden="true">
  {theme === 0 && <>
    <svg viewBox="0 0 520 440" fill="none">
      <path d="M44 386h432" stroke="#0f2723" stroke-width="20" stroke-linecap="round" />
      <rect x="125" y="49" width="229" height="337" rx="46" fill="#0f2723" />
      <rect x="108" y="32" width="229" height="337" rx="46" fill="#a8d6bb" />
      <rect x="129" y="61" width="187" height="284" rx="25" fill="#f7f0dc" />
      <path d="m129 61 137 29v280l-137-25z" fill="#f18e76" />
      <rect x="231" y="202" width="13" height="39" rx="6.5" fill="#173c34" />
      <path d="M287 347c21-36 60-48 113-44l54 73H284z" fill="#a8d6bb" />
      <circle cx="389" cy="96" r="42" fill="#f7f0dc" />
      <path d="m389 30 0-15m0 146v15m66-80h15M342 49l-12-12m106 12 12-12" stroke="#f7f0dc" stroke-width="9" stroke-linecap="round" />
      <path d="M396 366v-81" stroke="#f7f0dc" stroke-width="10" stroke-linecap="round" />
      <path d="M397 314c-51-1-62-24-61-46 39-1 61 13 61 46m1-23c-1-41 21-61 54-59 1 32-18 57-54 59" fill="#a8d6bb" />
      <g class="scene-symbol symbol-learn"><path d="M281 197c27-13 45-14 68-5v60c-23-9-41-8-68 5-27-13-45-14-68-5v-60c23-9 41-8 68 5" fill="#f7f0dc" stroke="#173c34" stroke-width="8" stroke-linejoin="round" /><path d="M281 200v53" stroke="#173c34" stroke-width="7" /></g>
      <g class="scene-symbol symbol-rest"><path d="M308 174c-28 18-26 53 4 67-34 15-67-5-67-34 0-24 24-42 63-33" fill="#173c34" /></g>
      <g class="scene-symbol symbol-connect"><path d="M274 251c-53-35-64-59-44-74 16-12 31-3 44 13 13-16 28-25 44-13 20 15 9 39-44 74" fill="#173c34" /></g>
    </svg>
    <span class="art-sticker door-sticker">Life goes<br />on out here.</span>
    <span class="art-foot">A good place to stop.</span>
  </>}

  {theme === 1 && <>
    <svg viewBox="0 0 520 440" fill="none">
      <rect x="68" y="81" width="396" height="286" rx="51" fill="#0f2723" />
      <rect x="52" y="65" width="396" height="286" rx="51" fill="#f7f0dc" />
      <path d="M111 137h279M111 211h279M111 285h279" stroke="#d4d9c6" stroke-width="22" stroke-linecap="round" />
      <path d="M111 137h87M111 285h139" stroke="#173c34" stroke-width="22" stroke-linecap="round" />
      <path class="boundary-fill" d="M111 211h190" stroke="#173c34" stroke-width="22" stroke-linecap="round" />
      <g class="knob knob-pace"><circle cx="198" cy="137" r="31" fill="#f18e76" /><path d="M190 127v20m16-20v20" stroke="#173c34" stroke-width="7" stroke-linecap="round" /></g>
      <g class="knob knob-boundary"><circle cx="301" cy="211" r="31" fill="#a8d6bb" /><path d="M293 201v20m16-20v20" stroke="#173c34" stroke-width="7" stroke-linecap="round" /></g>
      <g class="knob knob-support"><circle cx="250" cy="285" r="31" fill="#f18e76" /><path d="M242 275v20m16-20v20" stroke="#173c34" stroke-width="7" stroke-linecap="round" /></g>
      <path d="M38 47 24 31m441 9 18-17m-2 343 18 15" stroke="#a8d6bb" stroke-width="10" stroke-linecap="round" />
    </svg>
    <span class="art-sticker controls-sticker">Set by you.</span>
    <span class="control-label label-pace">Pace</span><span class="control-label label-boundary">Boundaries</span><span class="control-label label-support">Support</span>
    <span class="art-foot">Help you can choose.</span>
  </>}

  {theme === 2 && <>
    <svg viewBox="0 0 520 440" fill="none">
      <rect x="66" y="69" width="334" height="266" rx="43" fill="#0f2723" transform="rotate(-7 66 69)" />
      <rect x="50" y="53" width="334" height="266" rx="43" fill="#f7f0dc" transform="rotate(-7 50 53)" />
      <circle cx="218" cy="177" r="100" fill="#a8d6bb" />
      <path class="reflection-hands" d="M218 115v63l43 25" stroke="#173c34" stroke-width="13" stroke-linecap="round" stroke-linejoin="round" />
      <path d="m287 248 85 87" stroke="#f18e76" stroke-width="42" stroke-linecap="round" />
      <circle cx="218" cy="177" r="111" stroke="#173c34" stroke-width="20" />
      <g class="reflection-mark"><path d="m173 175 31 31 60-62" stroke="#173c34" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" /></g>
      <circle cx="399" cy="308" r="65" fill="#0f2723" />
      <circle cx="389" cy="296" r="65" fill="#f7f0dc" />
      <circle cx="389" cy="296" r="43" fill="#a8d6bb" />
      <path class="adjust-needle" d="m389 296 26-28" stroke="#173c34" stroke-width="11" stroke-linecap="round" />
    </svg>
    <span class="art-sticker insight-sticker">See it clearly.</span>
    <span class="art-foot">A change within reach.</span>
  </>}

  {theme === 3 && <>
    <svg viewBox="0 0 520 440" fill="none">
      <path d="M61 81c0-21 17-38 38-38h190c21 0 38 17 38 38v112c0 21-17 38-38 38h-92l-66 50v-50H99c-21 0-38-17-38-38z" fill="#0f2723" />
      <path d="M46 65c0-21 17-38 38-38h190c21 0 38 17 38 38v112c0 21-17 38-38 38h-92l-66 50v-50H84c-21 0-38-17-38-38z" fill="#a8d6bb" />
      <path d="M189 147c0-21 17-38 38-38h205c21 0 38 17 38 38v104c0 21-17 38-38 38h-30v45l-65-45H227c-21 0-38-17-38-38z" fill="#0f2723" />
      <path d="M174 132c0-21 17-38 38-38h205c21 0 38 17 38 38v104c0 21-17 38-38 38h-30v45l-65-45H212c-21 0-38-17-38-38z" fill="#f7f0dc" />
      <circle cx="123" cy="100" r="10" fill="#173c34" /><circle cx="166" cy="100" r="10" fill="#173c34" />
      <path d="M123 132c13 13 28 13 42 0" stroke="#173c34" stroke-width="8" stroke-linecap="round" />
      <path class="connection-heart" d="M312 228c-48-31-59-53-40-67 15-11 28-3 40 12 12-15 25-23 40-12 19 14 8 36-40 67" fill="#f18e76" />
      <g class="connection-source"><path d="M279 151h69v72h-69z" fill="#a8d6bb" /><path d="M294 167h39m-39 15h28m-28 17 10 10 24-24" stroke="#173c34" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" /></g>
      <path d="M139 272 84 292v38c0 36 26 58 55 70 29-12 55-34 55-70v-38z" fill="#f18e76" />
      <rect x="117" y="323" width="44" height="34" rx="8" fill="#173c34" /><path d="M125 323v-12c0-19 28-19 28 0v12" stroke="#173c34" stroke-width="8" />
    </svg>
    <span class="art-sticker together-sticker">Closer, on<br />your terms.</span>
    <span class="art-foot">Connection. Privacy. Trust.</span>
  </>}
</div>

<style>
  .principle-art { position: relative; width: 100%; aspect-ratio: 520 / 470; color: #173c34; }
  svg { display: block; width: 100%; overflow: visible; }
  .art-sticker { position: absolute; font: 850 clamp(.95rem, 1.7vw, 1.35rem)/1.15 Nunito, sans-serif; text-align: center; background: #f7f0dc; padding: 13px 19px; border-radius: 9px; box-shadow: 0 6px 0 #0f2723; }
  .art-foot { position: absolute; bottom: 0; left: 0; right: 0; text-align: center; font: 850 clamp(.9rem, 1.4vw, 1.1rem)/1.4 Nunito, sans-serif; color: #f7f0dc; }
  .door-sticker { left: 2%; top: 48%; transform: rotate(-9deg); }
  .controls-sticker { right: 4%; top: -1%; transform: rotate(8deg); background: #a8d6bb; }
  .control-label { position: absolute; left: 15%; font: 900 clamp(.65rem, 1.1vw, .88rem)/1 Nunito, sans-serif; color: #173c34; }
  .label-pace { top: 18%; } .label-boundary { top: 34%; } .label-support { top: 50%; }
  .insight-sticker { left: 1%; top: 65%; transform: rotate(-6deg); background: #f18e76; }
  .together-sticker { right: 3%; top: 69%; transform: rotate(7deg); background: #a8d6bb; }
  .scene-symbol, .reflection-mark, .connection-source { display: none; }
  :global([data-visual-mode="explore"][data-selection="0"]) .symbol-learn,
  :global([data-visual-mode="explore"][data-selection="1"]) .symbol-rest,
  :global([data-visual-mode="explore"][data-selection="2"]) .symbol-connect { display: block; }
  :global([data-visual-mode="explore"][data-selection="0"]) .knob-boundary { transform: translateX(-110px); }
  :global([data-visual-mode="explore"][data-selection="1"]) .knob-boundary { transform: translateX(55px); }
  :global([data-visual-mode="explore"][data-selection="2"]) .knob-boundary { transform: translateX(-20px); }
  .boundary-fill { transform-origin: 111px 211px; }
  :global([data-visual-mode="explore"][data-selection="0"]) .boundary-fill { transform: scaleX(.421053); }
  :global([data-visual-mode="explore"][data-selection="1"]) .boundary-fill { transform: scaleX(1.289474); }
  :global([data-visual-mode="explore"][data-selection="2"]) .boundary-fill { transform: scaleX(.894737); }
  :global([data-visual-mode="explore"][data-selection="0"]) .reflection-mark { display: block; }
  :global([data-visual-mode="explore"][data-selection="0"]) .reflection-hands { opacity: 0; }
  .adjust-needle { transform-origin: 389px 296px; }
  :global([data-selection="1"]) .adjust-needle { transform: rotate(-55deg); }
  :global([data-selection="2"]) .adjust-needle { transform: rotate(45deg); }
  :global([data-visual-mode="explore"][data-selection="2"]) .connection-source { display: block; }
  :global([data-visual-mode="explore"][data-selection="2"]) .connection-heart { display: none; }
  :global([data-visual-mode="explore"][data-selection="1"]) .art-3 .together-sticker { background: #f18e76; }
  @media (max-width: 700px) {
    .art-sticker { font-size: clamp(.8rem, 3.8vw, 1.1rem); padding: 10px 13px; }
    .art-foot { font-size: .88rem; }
    .control-label { font-size: clamp(.72rem, 3.1vw, .85rem); }
  }
</style>

  .return-line::before { content: ''; position: absolute; left: -4px; top: 3px; width: 6px; height: 6px; border-top: 1.5px solid var(--muted); border-left: 1.5px solid var(--muted); transform: rotate(45deg); }
  .return-line > span { position: relative; top: 31px; padding: 4px 10px; display: inline-block; background: var(--surface); border: 1px solid var(--line); border-radius: 20px; font-size: .68rem; color: var(--muted); }
  .choice-root { width: fit-content; padding: 12px 20px; align-self: center; border: 1px solid var(--accent); border-radius: 9px; color: var(--accent); background: var(--surface); font-size: .9rem; font-weight: 850; }

---
/**
 * A string hanging from a logo glyph with a draggable spider on the end.
 * Behaviour and feel: src/scripts/spider-string/ (tune in config.ts, or live
 * by opening the page with ?tune).
 *
 * The string and spider are both drawn on the canvas; the bob element is the
 * spider's invisible grab target.
 *
 * Emits bubbling `spider:grab`, `spider:release` and `spider:pluck` events
 * from the root, and sets `data-spider` / `data-string` ("idle|hover|held")
 * on it for styling hooks. Set `data-inactive` on it to stop it being grabbed.
 *
 * Pass `badge` instead of `anchor` for a badge: a spider that sits in that
 * element (sized to its width) on a thread from the top of the window, with
 * all its faces but no dragging, and presses go through it to the page.
 *
 * Pass `stage` and `hook` for the Spider Den's spider: it hangs from the
 * bottom-middle of `hook` down into `stage` (sized to its width, like a
 * badge), and can be played with like the one on the logo. `tryOn` shows
 * what's being tried on in the den rather than what's worn.
 */
type Props = { tryOn?: boolean } & (
  | {
      /** CSS selector for the SVG glyph the string hangs from. */
      anchor: string;
      badge?: never;
      stage?: never;
      hook?: never;
    }
  | {
      /** CSS selector for the element the badge spider sits in. */
      badge: string;
      anchor?: never;
      stage?: never;
      hook?: never;
    }
  | {
      /** CSS selectors for the element the spider rests in, and the one its thread hangs from. */
      stage: string;
      hook: string;
      anchor?: never;
      badge?: never;
    }
);

const { anchor, badge, stage, hook, tryOn } = Astro.props;
---

<div
  class="spider-string"
  data-spider-string
  data-anchor={anchor}
  data-slot={badge ?? stage}
  data-hook={hook}
  data-mode={badge ? "badge" : stage ? "stage" : undefined}
  data-look={tryOn ? "try" : undefined}
  aria-hidden="true"
>
  <canvas class="canvas"></canvas>
  <div class="bob" data-bob></div>
</div>

<style>
  .spider-string {
    /* String colour: matches the logo ink in both themes. */
    color: var(--ink);
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 10;
    user-select: none;
    -webkit-user-select: none;
  }
  /* String → String → "Behind the logo & text": the spider can go up behind the
     logo and show through the hole in the b. */
  .spider-string[data-behind] {
    z-index: 0;
  }
  .canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Invisible grab target that follows the spider (the spider itself is drawn on the canvas). */
  .bob {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--bob-w, 0);
    height: var(--bob-h, 0);
    pointer-events: auto;
    touch-action: none;
    cursor: grab;
    -webkit-user-drag: none;
  }
  /* A badge, or a rig that's been switched off, can't be grabbed: presses go through to the page. */
  .spider-string[data-mode="badge"] .bob,
  .spider-string[data-inactive] .bob {
    pointer-events: none;
  }
  /* Bigger hit area than the spider itself (config bob.hitArea), so it's easy to grab. */
  .bob::after {
    content: "";
    position: absolute;
    inset: var(--bob-hit, -35%);
    border-radius: 50%;
  }
  /* Debug (Spidey → Debug → Show grab area). */
  .bob[data-show-hit]::after {
    outline: 1px dashed #ff5a5f;
  }
  /* The string is drawn on a canvas that ignores the pointer, so its cursors are set page-wide. */
  :global(html.spider-string-hover),
  :global(html.spider-string-hover *) {
    cursor: grab !important;
  }
  :global(html.spider-held),
  :global(html.spider-held *) {
    cursor: grabbing !important;
    user-select: none;
    -webkit-user-select: none;
  }
</style>

<script>
  import { mountAll } from "../scripts/spider-string";
  mountAll();
</script>

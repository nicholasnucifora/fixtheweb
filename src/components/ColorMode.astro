<!-- Run before first paint. A layout choice never changes this preference. -->
<script is:inline>
  (() => {
    let choice;
    try { choice = localStorage.getItem('ftw.color-mode.v1'); } catch {}
    document.documentElement.dataset.colorMode = choice === 'light' || choice === 'dark'
      ? choice : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  })();
</script>
<script>
  const key = "ftw.color-mode.v1";
  const system = matchMedia("(prefers-color-scheme: dark)");
  const readChoice = () => {
    try { return localStorage.getItem(key); } catch { return null; }
  };
  let choice = readChoice();
  const update = () => {
    const mode = choice === "light" || choice === "dark" ? choice : system.matches ? "dark" : "light";
    document.documentElement.dataset.colorMode = mode;
    document.querySelectorAll<HTMLButtonElement>("[data-color-mode-toggle]").forEach(button => {
      button.setAttribute("aria-pressed", String(mode === "dark"));
      button.setAttribute("aria-label", `Switch to ${mode === "dark" ? "light" : "dark"} mode`);
      button.title = `Switch to ${mode === "dark" ? "light" : "dark"} mode`;
    });
    document.querySelectorAll<HTMLSourceElement>("[data-theme-source]").forEach(source => source.media = mode === "dark" ? "all" : "not all");
    window.dispatchEvent(new Event("ftw:color-mode"));
  };
  document.addEventListener("click", event => {
    if (!(event.target instanceof Element) || !event.target.closest("[data-color-mode-toggle]")) return;
    choice = document.documentElement.dataset.colorMode === "dark" ? "light" : "dark";
    try { localStorage.setItem(key, choice); } catch {}
    update();
  });
  system.addEventListener("change", () => { if (choice !== "dark" && choice !== "light") update(); });
  window.addEventListener("storage", event => { if (event.key === key || event.key === null) { choice = readChoice(); update(); } });
  update();
</script>

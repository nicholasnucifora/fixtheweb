<style is:global>
  @font-face { font-family: Fredoka; src: url('../assets/fonts/Fredoka.ttf') format('truetype'); font-weight: 300 700; font-display: swap; }
  @font-face { font-family: Nunito; src: url('../assets/fonts/Nunito.ttf') format('truetype'); font-weight: 200 1000; font-display: swap; }
  :root { --heading-font: Fredoka, 'Trebuchet MS', sans-serif; --body-font: Nunito, system-ui, sans-serif; --header-height: 80px; }
  body { font-family: var(--body-font); }
  h1, h2, h3 { font-family: var(--heading-font); font-weight: 600; }
  :root[data-design-type="soft"] { --heading-font: Nunito, system-ui, sans-serif; }
  :root[data-design-type="simple"] { --heading-font: 'Trebuchet MS', system-ui, sans-serif; }
  :root[data-color-mode="light"] { color-scheme: light; --bg: #fafaf7; --ink: #1b1e29; --accent: #2b8666; --surface: #fff; --header-bg: #f0f0e9; }
  :root[data-color-mode="dark"] { color-scheme: dark; --bg: #1b1e29; --ink: #f2f2ee; --accent: #6ac7a7; --surface: #222633; --header-bg: #282c3b; }
  :root { --muted: color-mix(in srgb, var(--ink) 65%, transparent); --line: color-mix(in srgb, var(--ink) 13%, transparent); --fill: color-mix(in srgb, var(--ink) 5%, transparent); --unbuilt: color-mix(in srgb, var(--ink) 38%, transparent); }
  a, button, input, select, textarea, summary { -webkit-tap-highlight-color: transparent; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  [id] { scroll-margin-top: 100px; }
  .home .section h2 { font-weight: 600; }
  .home .feature { border-radius: 26px; padding: 1.6rem; }
  .home .feature h3 { font-size: 1.3rem; font-weight: 550; }
  .home .eyebrow { text-transform: none; letter-spacing: .02em; font-size: .95rem; }
</style>

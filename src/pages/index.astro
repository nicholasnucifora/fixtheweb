---
import Logo from "../assets/brand/fixtheweb-logo.svg";
import { linkAttrs, type Link } from "../components/links";
import SpiderString from "../components/SpiderString.astro";
import Base from "../layouts/Base.astro";
import { WORTH_DEFAULT, isNone, lifeOf } from "../scripts/life/model";

/**
 * The home page, while Fix the Web is still being built: what the web costs an average life (a taste of
 * /life), a placeholder where the asks will go once they're written, and Villow, the app we're building
 * first.
 */

/** A taste of Your Life on Screens (/life): the rest of an average 15-year-old Australian's life, worked out the same way. */
const teen = lifeOf({ age: 15, country: "au", sex: "everyone", screens: null, worth: WORTH_DEFAULT });
const one = (years: number) => years.toFixed(1);
const percent = (share: number) => `${Math.round(share * 100)}%`;
/** Screens as a share of the years that are left, and of the waking ones. */
const ofLife = percent(teen.years.screens / teen.left);
const ofWaking = percent(teen.years.screens / (teen.left - teen.years.sleep));

/** Our work: a taste of Villow. Its own site goes into the detail; give `site` an href once it's live. */
const villow = {
  site: { label: "Visit Villow" } as Link,
  features: [
    {
      title: "A subscription feed worth using",
      body: "Choose how often each channel shows up and which kinds of videos you want from them, so the feed you picked beats the one picked for you.",
    },
    {
      title: "The algorithm, on your terms",
      body: "We don't ban recommendations. Our YouTube extension lets you cap how many you see, how many videos you watch and how long you spend each day.",
    },
    {
      title: "Swipe, then reflect",
      body: "Swipe through what's waiting to pick what's worth your time, and rate every video once it ends: did you actually enjoy that?",
    },
    {
      title: "See where your time really goes",
      body: "What you watched, when, and how much you liked it, across desktop and mobile. Then suggestions from your own ratings, like dropping a channel you keep disliking.",
    },
    {
      title: "Social that brings people together",
      body: "Watch with friends, send them videos and see who watched, and catch what's popular in your country today, so we're not each stuck in our own bubble.",
    },
    {
      title: "Back to real life",
      body: "Creators can add a call to action to go and do something offline, and Villow can put your to-do list in front of you when you hit a limit.",
    },
  ],
};
---

<Base title="Fix the Web · In development" page="home">
  <main>
    <section class="hero" id="top">
      <h1><Logo class="logo" role="img" aria-label="Fix the Web" /></h1>
      <p class="status">In development · not launched yet</p>
      <p class="hero-note">We're building Villow first. Fix the Web comes after it.</p>
    </section>

    <section class="section intro">
      <h2 class="punchline">The web isn't broken by accident. <em>Let's fix it on purpose.</em></h2>
      <p class="lede">
        It's built to take as much of your time as it can get. That's the part we can already measure, so that's
        where this starts.
      </p>
    </section>

    <!-- What the web costs an average life, in plain type. The page it links to does the confronting part. -->
    <section class="section screens">
      <p class="eyebrow">Your life on screens</p>
      <h2 class="figure">
        An average 15&#8209;year&#8209;old in Australia has {one(teen.left)} years of life left.{" "}
        <em>{one(teen.years.screens)} of them go on a screen.</em>
      </h2>
      <p class="lede">
        That's {ofLife} of everything they have left, and {ofWaking} of the hours they'll be awake for. Once sleep,
        school, work and keeping a life running have taken their share,{" "}
        {
          isNone(teen.years.free)
            ? "there's no free time away from a screen left at all"
            : `${one(teen.years.free)} years of free time away from a screen are left`
        }.
      </p>
      <p class="screens-cta"><a href="/life">See what's left of yours →</a></p>
      <p class="note">
        From ABS life tables and the American Time Use Survey. <a href="/life#method">How we worked it out</a>.
      </p>
    </section>

    <!-- The asks go here once they're written. Until then it says so, rather than standing for anything yet. -->
    <section class="section pending">
      <p class="eyebrow">What we're pushing for</p>
      <h2>To be decided.</h2>
      <p>
        Fix the Web hasn't launched, and none of its asks are settled. When they are, each one will be a specific
        change we can point at, with the evidence behind it and its sources in the open. Nothing goes up here until
        it can be defended line by line.
      </p>
      <ul class="tbd">
        <li>TBD</li>
        <li>TBD</li>
        <li>TBD</li>
      </ul>
    </section>

    <section class="section work">
      <p class="eyebrow">Our work</p>
      <h2>Villow: proof it can be better</h2>
      <p class="lede">
        Villow is our app for watching YouTube, on desktop and mobile. It doesn't take the algorithm away. It hands you the
        controls platforms won't, and makes them fun enough that you'll actually use them.
      </p>
      <div class="features">
        {
          villow.features.map((feature) => (
            <article class="feature">
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </article>
          ))
        }
      </div>
      <div class="cta">
        <a class="button" {...linkAttrs(villow.site)}>{villow.site.label}</a>
        <p class="cta-note">Villow is what we're building first. Its own site isn't up yet either.</p>
      </div>
    </section>
  </main>

  <SpiderString anchor=".logo [data-glyph='b']" />
</Base>

<style is:global>
  main {
    /* Above the string and spider, which can pass behind it… */
    position: relative;
    z-index: 1;
    /* …but presses go through to the spider back there. */
    pointer-events: none;
  }
  main p,
  .section {
    pointer-events: auto;
  }

  /* ── The big logo ── */
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    padding: 2rem;
    box-sizing: border-box;
  }
  h1 {
    margin: 0;
  }
  .logo {
    display: block;
    width: min(80vw, 640px);
    height: auto;
  }
  /* None of this is live yet, and the page says so before anything else. */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.75rem 0 0;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--fill);
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .status::before {
    content: "";
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .hero-note {
    margin: 0.875rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  /* ── Content ── */
  .section {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 5rem var(--gutter);
  }
  .section + .section {
    border-top: 1px solid var(--line);
  }
  .section h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .section p {
    max-width: 62ch;
    margin: 0 0 1rem;
    color: var(--muted);
  }
  .eyebrow {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .section .eyebrow {
    margin-bottom: 0.75rem;
    color: var(--accent);
  }

  /* The punchline */
  .intro {
    padding-top: 6rem;
  }
  .section .punchline {
    max-width: 18ch;
    margin-bottom: 1.5rem;
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .punchline em {
    font-style: normal;
    color: var(--accent);
  }
  .section .lede {
    font-size: 1.25rem;
  }

  /*
   * Your Life on Screens, as plain type: the sentence set back, the years on screens in front of it. The
   * figures come from the same sums as /life, and the note under them says where they're from.
   */
  .section .figure {
    max-width: 26ch;
    margin-bottom: 1.5rem;
    color: var(--muted);
    font-size: clamp(1.625rem, 4vw, 2.375rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .figure em {
    display: block;
    margin-top: 0.3em;
    color: var(--ink);
    font-style: normal;
    font-weight: 800;
  }
  .section .screens-cta {
    margin: 1.5rem 0 0;
  }
  .screens-cta a {
    color: var(--accent);
    font-size: 1.1875rem;
    font-weight: 700;
    text-decoration: none;
  }
  .screens-cta a:hover,
  .screens-cta a:focus-visible {
    text-decoration: underline;
  }
  .section .note {
    max-width: none;
    margin: 1.75rem 0 0;
    font-size: 0.875rem;
  }
  .note a {
    color: inherit;
  }

  /* What we're pushing for: three spaces waiting for it. */
  .tbd {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .tbd li {
    display: grid;
    place-items: center;
    min-height: 7.5rem;
    border: 1px dashed color-mix(in srgb, var(--ink) 20%, transparent);
    border-radius: 16px;
    color: var(--unbuilt);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  @media (max-width: 560px) {
    .tbd li {
      min-height: 4.5rem;
    }
  }

  /* Our work: Villow */
  .work {
    padding-bottom: 7rem;
  }
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    margin: 2.5rem 0 2rem;
  }
  .feature {
    padding: 1.25rem 1.375rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .feature h3 {
    margin: 0 0 0.375rem;
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  .section .feature p {
    margin: 0;
    font-size: 0.9375rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.375rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    text-decoration: none;
  }
  /* Not built yet, like the header's links. */
  .button[aria-disabled="true"] {
    background: var(--fill);
    color: var(--unbuilt);
    cursor: default;
  }
  .section .cta-note {
    margin: 0;
    font-size: 0.9375rem;
  }
</style>

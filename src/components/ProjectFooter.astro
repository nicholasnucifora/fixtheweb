---
import Logo from "../assets/brand/fixtheweb-logo.svg";
---
<footer class="project-footer">
  <div class="ftw-shell footer-top">
    <div class="footer-purpose"><a href="/" aria-label="Fix the Web home"><Logo aria-hidden="true" /></a><p>Better digital experiences,<br />built and understood together.</p></div>
    <nav aria-label="Footer"><a href="/work/villow">Our first project</a><a href="/notes/design-and-access">Design &amp; access</a><a href="/ideas">Ideas to explore</a><a href="/about">About Fix the Web</a><a href="/#get-involved">Get involved</a></nav>
  </div>
  <div class="ftw-shell footer-bottom"><span>An independent project by Nicholas Nucifora.</span><a href="/old-pages">Old pages <span aria-hidden="true">↗</span></a></div>
</footer>
<style>
  .project-footer { margin-top: 48px; padding: 58px 0 26px; border-top: 1px solid var(--line); }
  .footer-top { display: flex; justify-content: space-between; gap: 40px; }
  .footer-purpose svg { display: block; width: 180px; height: auto; }
  .footer-purpose p { margin: 20px 0 0; color: var(--muted); font-size: .95rem; line-height: 1.65; }
  nav { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 48px; align-content: start; padding-top: 8px; }
  nav a { color: var(--ink); font-size: .95rem; text-decoration: none; font-weight: 750; padding: 4px 0; }
  a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
  .footer-bottom { display: flex; gap: 20px; justify-content: space-between; margin-top: 50px; padding-top: 22px; border-top: 1px solid var(--line); font-size: .78rem; color: var(--muted); }
  .footer-bottom a { color: inherit; }
  @media (max-width: 600px) { .footer-top { flex-direction: column; gap: 28px; } nav { gap: 10px 28px; }.footer-bottom { flex-wrap: wrap; margin-top: 34px; } }
</style>

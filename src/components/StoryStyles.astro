<style is:global>
  :root { --story-width: 1120px; --story-soft: color-mix(in srgb, var(--accent) 8%, var(--bg)); --story-warm: color-mix(in srgb, #dca981 12%, var(--bg)); }
  html { scrollbar-gutter: stable; }
  .ftw-shell { width: min(var(--story-width), calc(100% - 64px)); margin-inline: auto; }
  .ftw-page-intro { padding-top: 160px; padding-bottom: 64px; }
  .ftw-page-intro h1 { font-size: clamp(2.7rem, 5.5vw, 4.75rem); max-width: 900px; line-height: 1.08; letter-spacing: -.04em; margin: 16px 0 26px; text-wrap: balance; }
  .ftw-eyebrow { font-size: .8rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); margin: 0 0 18px; }
  .ftw-lead { max-width: 720px; font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.65; color: var(--muted); }
  .ftw-section { padding-block: 78px; }
  .ftw-section h2 { font-size: clamp(2rem, 3.6vw, 3.2rem); line-height: 1.15; letter-spacing: -.035em; margin: 0 0 24px; text-wrap: balance; }
  .ftw-section h3 { line-height: 1.25; }
  .ftw-reading { max-width: 740px; }
  .ftw-reading p { line-height: 1.8; }
  .ftw-reading h2 { margin-top: 56px; }
  .ftw-reading a, .ftw-section p a { color: var(--accent); text-underline-offset: 4px; }
  .ftw-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 26px; margin-top: 26px; }
  .ftw-button { display: inline-flex; align-items: center; justify-content: center; gap: 24px; padding: 14px 23px; border-radius: 999px; background: var(--accent); color: var(--bg); font-size: .92rem; font-weight: 850; text-decoration: none; min-height: 24px; }
  .ftw-button:hover { filter: brightness(1.08); }
  .ftw-text-link { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-size: .92rem; font-weight: 800; text-decoration-thickness: 1px; text-underline-offset: 5px; padding-block: 9px; }
  .ftw-text-link:hover { color: var(--accent); }
  .ftw-skip { position: fixed; top: 10px; left: 16px; z-index: 100; padding: 12px 20px; background: var(--surface); color: var(--ink); border-radius: 10px; transform: translateY(-160%); }
  .ftw-skip:focus { transform: translateY(0); }
  main:focus { outline: none; }
  @media (max-width: 700px) {
    .ftw-shell { width: calc(100% - 40px); }
    .ftw-page-intro { padding-top: 122px; padding-bottom: 40px; }
    .ftw-section { padding-block: 54px; }
    .ftw-page-intro h1 { font-size: clamp(2.35rem, 9vw, 3.3rem); }
  }
</style>

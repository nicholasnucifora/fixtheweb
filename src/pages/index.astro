---
import Base from "../layouts/Base.astro";
import HomeHero from "../components/HomeHero.astro";
import SpiderString from "../components/SpiderString.astro";

// No URL or browser-storage flag can include the preview in a production build.
const HomePreview = import.meta.env.DEV ? (await import("../previews/home.astro")).default : null;
---

{
  HomePreview ? <HomePreview /> : (
    <Base title="Fix the Web · Coming soon" page="home">
      <main class="home">
        <HomeHero />
      </main>
      <SpiderString anchor=".logo [data-glyph='b']" />
    </Base>
  )
}

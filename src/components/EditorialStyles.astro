<style is:global>
  .editorial { --heading-font: Nunito, sans-serif; }
  .editorial h1, .editorial h2, .editorial h3 { font-weight: 850; }
  .editorial p { text-wrap: pretty; }
  .editorial .muted, .editorial .prose p { color: var(--muted); }
  .editorial .prose { max-width: 730px; line-height: 1.8; }
  .editorial .prose p { margin: 0 0 1.15em; }
  .editorial .prose a { color: var(--accent); text-underline-offset: 4px; }
  .editorial .prose strong { color: var(--ink); }
  .editorial .split { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(32px, 6vw, 90px); align-items: start; }
  .editorial .split h2 { max-width: 520px; }
  .editorial .soft-band { background: var(--story-soft); }
  .editorial .warm-band { background: var(--story-warm); }
  .editorial .section-heading { max-width: 720px; margin-bottom: 40px; }
  .editorial .section-heading > p:last-child { color: var(--muted); }
  .editorial .index-links { display: flex; flex-wrap: wrap; gap: 8px 24px; border-block: 1px solid var(--line); padding: 18px 0; font-size: .88rem; }
  .editorial .index-links a { color: var(--ink); text-underline-offset: 5px; padding-block: 5px; }
  .editorial .index-links a:hover { color: var(--accent); }
  .editorial .numbered-list { list-style: none; margin: 0; padding: 0; counter-reset: items; }
  .editorial .numbered-list > li { counter-increment: items; display: grid; grid-template-columns: 34px 1fr; gap: 14px; border-top: 1px solid var(--line); padding: 28px 0; }
  .editorial .numbered-list > li::before { content: counter(items, decimal-leading-zero); color: var(--accent); font-size: .8rem; font-weight: 850; padding-top: 5px; }
  .editorial .numbered-list h3 { margin: 0 0 10px; font-size: 1.3rem; line-height: 1.25; }
  .editorial .numbered-list p { margin: 0; color: var(--muted); font-size: 1rem; }
  .editorial .statement { background: #233f39; color: #f6f7ed; border-radius: 26px; padding: clamp(28px, 4.5vw, 56px); }
  .editorial .statement .ftw-eyebrow { color: #a2d4ba; }
  .editorial .statement p:not(.ftw-eyebrow) { color: #d7e2d9; }
  .editorial .statement a { color: #c6e7cb; }
  .editorial .status-label { display: inline-block; padding: 6px 12px; border-radius: 999px; background: var(--story-warm); color: var(--ink); font-size: .74rem; font-weight: 800; }
  .editorial .topic-nav { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 28px; }
  .editorial .topic-nav a { color: var(--ink); border: 1px solid var(--line); border-radius: 999px; padding: 9px 16px; font-size: .83rem; text-decoration: none; }
  .editorial .topic-nav a:hover { border-color: var(--accent); background: var(--story-soft); }
  .editorial .source-note { color: var(--muted); font-size: .8rem; line-height: 1.6; }
  .editorial .source-note a { color: inherit; text-underline-offset: 3px; }
  .editorial .next-step { border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 36px; }
  .editorial .next-step > div { max-width: 660px; }
  .editorial .next-step .ftw-button { flex-shrink: 0; }
  .editorial :focus-visible { outline: 3px solid var(--accent); outline-offset: 5px; }
  @media (max-width: 760px) { .editorial .split { grid-template-columns: 1fr; gap: 24px; } .editorial .next-step { align-items: start; flex-direction: column; gap: 12px; } }
</style>
